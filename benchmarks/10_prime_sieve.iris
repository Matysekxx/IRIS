// Benchmark 10: Sieve of Eratosthenes
// Tests: Array access, integer math, large array allocation

fun main(): int {
    var limit: int = 1000000
    var primes: int[] = int[limit + 1]
    
    // Initialize (0 = prime, 1 = not prime)
    // All are prime by default (except 0 and 1)
    primes[0] = 1
    primes[1] = 1
    
    print("Finding primes up to 1,000,000...")
    
    var p: int = 2
    while (p * p <= limit) {
        // If primes[p] is 0, then it is a prime
        if (primes[p] == 0) {
            // Update all multiples of p
            var i: int = p * p
            while (i <= limit) {
                primes[i] = 1
                i = i + p
            }
        }
        p = p + 1
    }
    
    var count: int = 0
    var i: int = 0
    while (i <= limit) {
        if (primes[i] == 0) {
            count = count + 1
        }
        i = i + 1
    }
    
    print("Finished. Found " + count + " primes.")
    return count
}

main()
