from System import native time

fun main() {
    val n = 1000000
    val start = time()
    val arr = new int[n]
    for (var i = 0; i < n; i = i + 1) {
        arr[i] = i
    }
    var sum = 0
    for (var i = 0; i < n; i = i + 1) {
        sum = sum + arr[i]
    }
    val end = time()
    print("Test 3: Raw Array (1M): " + (end - start) + " ms")
}
main()
