from System import native time

fun sort(arr: int[]) {
    val n = len(arr)
    for (var i = 0; i < n; i = i + 1) {
        for (var j = 0; j < n - i - 1; j = j + 1) {
            if (arr[j] > arr[j + 1]) {
                val temp = arr[j]
                arr[j] = arr[j + 1]
                arr[j + 1] = temp
            }
        }
    }
}

fun main() {
    val n = 3000
    val arr = new int[n]
    for (var i = 0; i < n; i = i + 1) {
        arr[i] = n - i
    }
    
    val start = time()
    sort(arr)
    val end = time()
    print("Test 7: Bubble Sort (3k): " + (end - start) + " ms")
}
main()
