// Benchmark 6: Tail-recursive sum (TCO test)
// Tests: Tail-call optimization

fun sum_tail(n: int, acc: int): int {
    if (n == 0) {
        return acc
    }
    return sum_tail(n - 1, acc + n)
}

fun main(): int {
    var result: int = sum_tail(10000000, 0)
    print("Tail recursion sum: " + result)
    return result
}

main()
