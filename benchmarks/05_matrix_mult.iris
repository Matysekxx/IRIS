from System import native time

fun main() {
    val n = 100
    val A = new any[n]
    val B = new any[n]
    val C = new any[n]
    for (var i = 0; i < n; i = i + 1) {
        A[i] = new double[n]
        B[i] = new double[n]
        C[i] = new double[n]
    }

    val start = time()
    for (var i = 0; i < n; i = i + 1) {
        val rowA = A[i]
        val rowC = C[i]
        for (var j = 0; j < n; j = j + 1) {
            var s = 0.0
            for (var k = 0; k < n; k = k + 1) {
                val rowB = B[k]
                s = s + rowA[k] * rowB[j]
            }
            rowC[j] = s
        }
    }
    val end = time()
    print("Test 5: Matrix Mult (100x100): " + (end - start) + " ms")
}
main()
