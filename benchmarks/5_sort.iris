val size = 5000
val arr = int[size]

var i = 0
while (i < size) {
    arr[i] = size - i
    i = i + 1
}

var changed = true
while (changed) {
    changed = false
    var j = 0
    while (j < size - 1) {
        if (arr[j] > arr[j + 1]) {
            val temp = arr[j]
            arr[j] = arr[j + 1]
            arr[j + 1] = temp
            changed = true
        }
        j = j + 1
    }
}
