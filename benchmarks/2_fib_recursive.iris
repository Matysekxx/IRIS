// Benchmark 2: Recursive Fibonacci
// Tests: Function call overhead, recursion (no TCO possible)

fun fib(n: int): int {
    if (n <= 1) {
        return n
    }
    return fib(n - 1) + fib(n - 2)
}

fun main(): int {
    var result: int = fib(35)
    print("Fibonacci(35): " + result)
    return result
}

main()
