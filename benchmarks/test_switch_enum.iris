enum Status {
    START = 1,
    PROGRESS = 2,
    END = 3
}

fun checkStatus(s: int) {
    switch (s) {
        case Status.START:
            print("Status: Started")
        case Status.PROGRESS:
            print("Status: In Progress")
        case Status.END:
            print("Status: Finished")
        default:
            print("Status: Unknown")
    }
}

checkStatus(Status.START)
checkStatus(2)
checkStatus(Status.END)
checkStatus(99)
