// Benchmark 9: Matrix Multiplication (100x100)
// Tests: Array indexing, nested loops, floating point math

fun main(): int {
    var size: int = 100
    var a: double[] = double[size * size]
    var b: double[] = double[size * size]
    var c: double[] = double[size * size]
    
    // Initialize matrices
    var i: int = 0
    while (i < size) {
        var j: int = 0
        while (j < size) {
            a[i * size + j] = i + j
            b[i * size + j] = i - j
            j = j + 1
        }
        i = i + 1
    }
    
    print("Multiplying 100x100 matrices...")
    
    i = 0
    while (i < size) {
        var j: int = 0
        while (j < size) {
            var sum: double = 0.0
            var k: int = 0
            while (k < size) {
                sum = sum + a[i * size + k] * b[k * size + j]
                k = k + 1
            }
            c[i * size + j] = sum
            j = j + 1
        }
        i = i + 1
    }
    
    print("Matrix multiplication finished.")
    
    // Check one value to ensure correct computation
    print("Result at [50, 50]: " + c[50 * size + 50])
    return 0
}

main()
