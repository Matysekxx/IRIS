// Benchmark 7: Sorting benchmark
// Tests: Array manipulation, comparisons, swaps

fun partition(arr: int[], low: int, high: int): int {
    var pivot: int = arr[high]
    var i: int = low - 1
    var j: int = low
    
    while (j < high) {
        if (arr[j] < pivot) {
            i = i + 1
            var temp: int = arr[i]
            arr[i] = arr[j]
            arr[j] = temp
        }
        j = j + 1
    }
    
    var temp: int = arr[i + 1]
    arr[i + 1] = arr[high]
    arr[high] = temp
    return i + 1
}

fun quicksort(arr: int[], low: int, high: int) {
    if (low < high) {
        var pi: int = partition(arr, low, high)
        quicksort(arr, low, pi - 1)
        quicksort(arr, pi + 1, high)
    }
}

fun main(): int {
    var size: int = 100000
    var arr: int[] = int[size]
    
    // Fill with pseudo-random values
    var seed: int = 12345
    var i: int = 0
    while (i < size) {
        seed = (seed * 1103515245 + 12345) % 2147483648
        arr[i] = seed % 10000
        i = i + 1
    }
    
    // Sort
    print("Sorting 100K elements...")
    quicksort(arr, 0, size - 1)
    print("Sorting finished.")
    
    // Verify sorted
    var sorted: int = 1
    i = 0
    while (i < size - 1) {
        if (arr[i] > arr[i + 1]) {
            sorted = 0
        }
        i = i + 1
    }
    
    print("Sorted correctly: " + sorted)
    return sorted
}

main()