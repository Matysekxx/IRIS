from System import native time
from System import native hash

class Entry {
    val key: int
    var value: int
    var next: Entry
    Entry(k: int, v: int) {
        this.key = k
        this.value = v
        this.next = null
    }
}

class FastMap {
    var buckets: Entry[]
    FastMap() {
        this.buckets = new Entry[1024]
    }
    fun put(k: int, v: int) {
        val h = hash(k)
        var idx = h % 1024
        if (idx < 0) { idx = -idx }
        val e = new Entry(k, v)
        e.next = this.buckets[idx]
        this.buckets[idx] = e
    }
}

fun main() {
    val n = 100000
    val map = new FastMap()
    val start = time()
    for (var i = 0; i < n; i = i + 1) {
        map.put(i, i)
    }
    val end = time()
    print("Test 9: HashMap Put (100k): " + (end - start) + " ms")
}
main()
