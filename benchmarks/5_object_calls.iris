// Benchmark 5: Object method calls
// Tests: OOP, method dispatch, object creation

class Point {
    public var x: int
    public var y: int
    
    fun init(x: int, y: int) {
        this.x = x
        this.y = y
    }
    
    fun distance(): int {
        return this.x * this.x + this.y * this.y
    }
}

fun main(): int {
    var points: Point[] = Point[1000000]
    var i: int = 0
    
    // Create objects
    while (i < 1000000) {
        points[i] = Point(i, i + 1)
        i = i + 1
    }
    
    // Call methods
    var total: int = 0
    i = 0
    while (i < 1000000) {
        total = total + points[i].distance()
        i = i + 1
    }
    
    print("Total distance: " + total)
    return total
}

main()
