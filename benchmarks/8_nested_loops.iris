// Benchmark 8: Nested loops
// Tests: Nested loop overhead and basic math

fun main(): int {
    var count: int = 0
    var i: int = 0
    while (i < 10000) {
        var j: int = 0
        while (j < 10000) {
            count = count + 1
            j = j + 1
        }
        i = i + 1
    }
    print("Nested loop result: " + count)
    return count
}

main()
