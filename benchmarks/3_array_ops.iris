// Benchmark 3: Array operations
// Tests: Array allocation, indexing, iteration

fun main(): int {
    var size: int = 10000000
    var arr: int[] = int[size]
    
    // Fill array
    var i: int = 0
    while (i < size) {
        arr[i] = i * 2 + 1
        i = i + 1
    }
    
    // Sum array
    var sum: int = 0
    i = 0
    while (i < size) {
        sum = sum + arr[i]
        i = i + 1
    }
    
    print("Array Sum: " + sum)
    return sum
}

main()
