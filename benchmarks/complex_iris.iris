from System import native time

fun matrix_mult(n: int): double {
    val A = new any[n]
    val B = new any[n]
    val C = new any[n]
    for (var i = 0; i < n; i = i + 1) {
        A[i] = new double[n]
        B[i] = new double[n]
        C[i] = new double[n]
    }
    
    val start = time()
    for (var i = 0; i < n; i = i + 1) {
        val rowA = A[i]
        val rowC = C[i]
        for (var j = 0; j < n; j = j + 1) {
            var s = 0.0
            for (var k = 0; k < n; k = k + 1) {
                val rowB = B[k]
                s = s + rowA[k] * rowB[j]
            }
            rowC[j] = s
        }
    }
    val end = time()
    return end - start
}

fun sieve(limit: int): double {
    val start = time()
    val primes = new int[limit + 1]
    for (var p = 2; p * p <= limit; p = p + 1) {
        if (primes[p] == 0) {
            for (var i = p * p; i <= limit; i = i + p) {
                primes[i] = 1
            }
        }
    }
    val end = time()
    return end - start
}

fun bench_complex() {
    print("IRIS Complex Benchmarks")
    val mTime = matrix_mult(100)
    print("Matrix Mult (100x100): " + mTime + " ms")

    val sTime = sieve(1000000)
    print("Sieve of Erato. (1M): " + sTime + " ms")
}
bench_complex()