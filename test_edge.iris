print(1 < 2);  // true
print(2 < 1);  // false
print(1 < 1);  // false
print(3.0 > 1.0); // true
print(1.0 > 1.0); // false
print(2 <= 2); // true
print(3 <= 2); // false
print(2 >= 2); // true
print(1 >= 3); // false
print(1 <= 2); // true
print(5.0 <= 5.0); // true
print(5.0 >= 5.0); // true
print(7 >= 3.0); // true (int >= double)
print(3.0 > 7); // false (double > int)
print(3.0 < 7); // true (double < int)
