import { time as _time } "native:System"

class _TimerTask {
    val callback: any
    val delay: double
    var last_run: double

    _TimerTask(cb: any, d: double) {
        this.callback = cb
        this.delay = d
        this.last_run = _time()
    }

    fun run() {
        this.callback()
        this.last_run = _time()
    }

    fun is_ready(now: double): bool {
        return now - this.last_run >= this.delay
    }
}

export fun time(): double {
    return _time()
}

export fun sleep(ms: double) {
    val start = _time()
    var now = _time()
    while (now - start < ms) {
        now = _time()
    }
}

export class Timer {
    var tasks: any[]

    Timer() {
        this.tasks = new any[0]
    }

    fun schedule(callback: any, delay_ms: double) {
        val task = new _TimerTask(callback, delay_ms)
        val old = this.tasks
        this.tasks = new any[len(old) + 1]
        for (var i = 0; i < len(old); i = i + 1) { this.tasks[i] = old[i] }
        this.tasks[len(old)] = task
    }

    fun tick() {
        val now = _time()
        for (var i = 0; i < len(this.tasks); i = i + 1) {
            val t = this.tasks[i]
            if (t != null && t.is_ready(now)) {
                t.run()
            }
        }
    }

    fun clear() {
        this.tasks = new any[0]
    }
}
