/**
 * Set<T> ensures a collection of unique elements.
 */
import "Map"

class Set<T> {
    private val map: Map<T, bool>
    
    Set() {
        this.map = new Map<T, bool>()
    }
    
    fun add(item: T) {
        val m = this.map
        m.put(item, true)
    }
    
    fun contains(item: T): bool {
        val m = this.map
        return m.contains(item)
    }
    
    fun remove(item: T) {
        val m = this.map
        m.remove(item)
    }
    
    fun size(): int {
        val m = this.map
        return m.size()
    }
}
