/**
 * Map<K, V> provides an efficient key-value store using a Hash Table.
 */
import { hash } "native:System"

class MapEntry<K, V> {
    val key: K
    var value: V
    var next: MapEntry<K, V>

    MapEntry(key: K, value: V) {
        this.key = key
        this.value = value
        this.next = null
    }
}

export class Map<K, V> {
    private var buckets: MapEntry<K, V>[]
    private var _size: int
    private val loadFactor = 0.75

    Map() {
        this._size = 0
        this.buckets = new MapEntry<K, V>[16]
    }

    fun size(): int { return this._size }
    fun isEmpty(): bool { return this._size == 0 }

    fun put(key: K, value: V) {
        if (this._size > len(this.buckets) * this.loadFactor) {
            this.resize()
        }

        val h = hash(key)
        var idx = h % len(this.buckets)
        if (idx < 0) { idx = -idx }

        var current = this.buckets[idx]
        while (current != null) {
            if (current.key == key) {
                current.value = value
                return
            }
            current = current.next
        }

        val entry = new MapEntry<K, V>(key, value)
        entry.next = this.buckets[idx]
        this.buckets[idx] = entry
        this._size = this._size + 1
    }

    fun get(key: K): V {
        val h = hash(key)
        var idx = h % len(this.buckets)
        if (idx < 0) { idx = -idx }

        var current = this.buckets[idx]
        while (current != null) {
            if (current.key == key) {
                return current.value
            }
            current = current.next
        }
        return null
    }

    fun contains(key: K): bool {
        return this.get(key) != null
    }

    fun remove(key: K): V {
        val h = hash(key)
        var idx = h % len(this.buckets)
        if (idx < 0) { idx = -idx }

        var current = this.buckets[idx]
        var prev: MapEntry<K, V> = null
        while (current != null) {
            if (current.key == key) {
                if (prev == null) {
                    this.buckets[idx] = current.next
                } else {
                    prev.next = current.next
                }
                this._size = this._size - 1
                return current.value
            }
            prev = current
            current = current.next
        }
        return null
    }

    private fun resize() {
        val oldBuckets = this.buckets
        val newLen = len(oldBuckets) * 2
        this.buckets = new MapEntry<K, V>[newLen]
        this._size = 0

        for (var i = 0; i < len(oldBuckets); i = i + 1) {
            var current = oldBuckets[i]
            while (current != null) {
                this.put(current.key, current.value)
                current = current.next
            }
        }
    }
}
