import { FileInputStream as NativeFileInputStream } "native:IO"
import { FileOutputStream as NativeFileOutputStream } "native:IO"

/// Stream that can be read from (file, network, etc.).
export interface InputStream {
    fun read(): int
    fun readLine(): string
    fun readAll(): string
    fun close()
}

/// Stream that can be written to (file, network, etc.).
export interface OutputStream {
    fun write(val: any)
    fun writeLine(val: string)
    fun flush()
    fun close()
}

/// Reads data from a file. Implements InputStream.
export class FileInputStream : InputStream {
    private val nativeStream: any

    FileInputStream(path: string) {
        this.nativeStream = NativeFileInputStream(path)
    }

    override fun read(): int {
        val ns = this.nativeStream
        return ns.read()
    }

    override fun readLine(): string {
        val ns = this.nativeStream
        return ns.readLine()
    }

    override fun readAll(): string {
        val ns = this.nativeStream
        return ns.readAll()
    }

    override fun close() {
        val ns = this.nativeStream
        ns.close()
    }
}

/// Writes data to a file. Implements OutputStream.
export class FileOutputStream : OutputStream {
    private val nativeStream: any

    FileOutputStream(path: string, append: bool) {
        this.nativeStream = NativeFileOutputStream(path, append)
    }

    override fun write(val: any) {
        val ns = this.nativeStream
        ns.write(val)
    }

    override fun writeLine(val: string) {
        val ns = this.nativeStream
        ns.writeLine(val)
    }

    override fun flush() {
        val ns = this.nativeStream
        ns.flush()
    }

    override fun close() {
        val ns = this.nativeStream
        ns.close()
    }
}

/// Buffered reader that wraps an InputStream for efficient text reading.
export class BufferedReader {
    private val stream: InputStream

    BufferedReader(stream: InputStream) {
        this.stream = stream
    }

    fun readLine(): string {
        val s = this.stream
        return s.readLine()
    }

    fun readAll(): string {
        val s = this.stream
        return s.readAll()
    }

    fun close() {
        val s = this.stream
        s.close()
    }
}

/// Buffered writer that wraps an OutputStream for efficient text writing.
export class BufferedWriter {
    private val stream: OutputStream

    BufferedWriter(stream: OutputStream) {
        this.stream = stream
    }

    fun write(s: string) {
        val st = this.stream
        st.write(s)
    }

    fun writeLine(s: string) {
        val st = this.stream
        st.writeLine(s)
    }

    fun newLine() {
        val st = this.stream
        st.writeLine("")
    }

    fun flush() {
        val st = this.stream
        st.flush()
    }

    fun close() {
        val st = this.stream
        st.close()
    }
}
