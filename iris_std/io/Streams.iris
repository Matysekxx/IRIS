from IO import native FileInputStream as NativeFileInputStream
from IO import native FileOutputStream as NativeFileOutputStream

interface InputStream {
    fun read(): int
    fun readLine(): string
    fun readAll(): string
    fun close()
}

interface OutputStream {
    fun write(val: any)
    fun writeLine(val: string)
    fun flush()
    fun close()
}

class FileInputStream : InputStream {
    private val nativeStream: any

    FileInputStream(path: string) {
        this.nativeStream = NativeFileInputStream(path)
    }

    override fun read(): int {
        return this.nativeStream.read()
    }

    override fun readLine(): string {
        return this.nativeStream.readLine()
    }

    override fun readAll(): string {
        return this.nativeStream.readAll()
    }

    override fun close() {
        this.nativeStream.close()
    }
}

class FileOutputStream : OutputStream {
    private val nativeStream: any

    FileOutputStream(path: string, append: bool) {
        this.nativeStream = NativeFileOutputStream(path, append)
    }

    override fun write(val: any) {
        this.nativeStream.write(val)
    }

    override fun writeLine(val: string) {
        this.nativeStream.writeLine(val)
    }

    override fun flush() {
        this.nativeStream.flush()
    }

    override fun close() {
        this.nativeStream.close()
    }
}

class BufferedReader {
    private val stream: InputStream

    BufferedReader(stream: InputStream) {
        this.stream = stream
    }

    fun readLine(): string {
        return this.stream.readLine()
    }

    fun readAll(): string {
        return this.stream.readAll()
    }

    fun close() {
        this.stream.close()
    }
}

class BufferedWriter {
    private val stream: OutputStream

    BufferedWriter(stream: OutputStream) {
        this.stream = stream
    }

    fun write(s: string) {
        this.stream.write(s)
    }

    fun writeLine(s: string) {
        this.stream.writeLine(s)
    }

    fun newLine() {
        this.stream.writeLine("")
    }

    fun flush() {
        this.stream.flush()
    }

    fun close() {
        this.stream.close()
    }
}
