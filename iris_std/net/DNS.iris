/// DNS resolution utilities.
export class DNS {
    /// Resolve a hostname to an IP address string.
    /// Returns null if resolution fails.
    static fun resolve(hostname: string): string {
        return nativeResolve(hostname)
    }

    /// Resolve a hostname to all IP addresses.
    static fun resolveAll(hostname: string): string[] {
        return nativeResolveAll(hostname)
    }

    /// Get the hostname for an IP address (reverse DNS).
    static fun reverseLookup(ip: string): string {
        return nativeReverseLookup(ip)
    }

    private native fun nativeResolve(hostname: string): string
    private native fun nativeResolveAll(hostname: string): string[]
    private native fun nativeReverseLookup(ip: string): string
}