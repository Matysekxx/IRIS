import { time, random, randomSeed, randomRange } "native:System"

/// Pseudo-random number generation with multiple distributions.
export class Random {
    private static var seed: int = time()

    /// Initialize with a new seed
    static fun initSeed(newSeed: int) {
        Random.seed = newSeed
        randomSeed(newSeed)
    }

    /// Returns an int in [0, max)
    static fun nextInt(max: int): int {
        return randomRange(0, max)
    }

    /// Returns an int in [min, max)
    static fun nextRange(min: int, max: int): int {
        return randomRange(min, max)
    }

    /// Returns a random int (full range)
    static fun next(): int {
        return random()
    }

    /// Returns a double in [0.0, 1.0)
    static fun nextDouble(): double {
        return randomRange(0, 1000000) / 1000000.0
    }

    /// Returns a double in [min, max)
    static fun nextDoubleRange(min: double, max: double): double {
        return min + Random.nextDouble() * (max - min)
    }

    /// Returns true with the given probability (0.0 to 1.0)
    static fun nextBoolean(probability: double): bool {
        return Random.nextDouble() < probability
    }

    /// Shuffle an array in-place (Fisher-Yates)
    static fun shuffle(arr: any[]) {
        for (var i = len(arr) - 1; i > 0; i = i - 1) {
            val j = Random.nextInt(i + 1)
            val temp = arr[i]
            arr[i] = arr[j]
            arr[j] = temp
        }
    }

    /// Pick a random element from an array
    static fun choice(arr: any[]): any {
        if (len(arr) == 0) { return null }
        return arr[Random.nextInt(len(arr))]
    }

    /// Generate a random byte
    static fun nextByte(): byte {
        return byte(Random.nextInt(256))
    }

    /// Fill a byte array with random bytes
    static fun nextBytes(bytes: byte[]) {
        for (var i = 0; i < len(bytes); i = i + 1) {
            bytes[i] = Random.nextByte()
        }
    }
}