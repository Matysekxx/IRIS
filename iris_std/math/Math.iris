import "native:Math"

export class Math {
    static val PI = 3.141592653589793
    static val E = 2.718281828459045
    static val TAU = 6.283185307179586
    static val LN2 = 0.6931471805599453
    static val LN10 = 2.302585092994046
    static val SQRT2 = 1.4142135623730951
    static val SQRT1_2 = 0.7071067811865476

    static fun sin(x: double): double { return sin(x) }
    static fun cos(x: double): double { return cos(x) }
    static fun tan(x: double): double { return tan(x) }
    static fun asin(x: double): double { return asin(x) }
    static fun acos(x: double): double { return acos(x) }
    static fun atan(x: double): double { return atan(x) }
    static fun atan2(y: double, x: double): double { return atan2(y, x) }
    static fun sinh(x: double): double { return sinh(x) }
    static fun cosh(x: double): double { return cosh(x) }
    static fun tanh(x: double): double { return tanh(x) }

    static fun sqrt(x: double): double { return sqrt(x) }
    static fun cbrt(x: double): double { return cbrt(x) }
    static fun hypot(x: double, y: double): double { return hypot(x, y) }

    static fun pow(x: double, y: double): double { return pow(x, y) }
    static fun exp(x: double): double { return exp(x) }
    static fun expm1(x: double): double { return expm1(x) }
    static fun log(x: double): double { return log(x) }
    static fun log1p(x: double): double { return log1p(x) }
    static fun log10(x: double): double { return log10(x) }
    static fun log2(x: double): double { return log2(x) }

    static fun floor(x: double): double { return floor(x) }
    static fun ceil(x: double): double { return ceil(x) }
    static fun round(x: double): double { return round(x) }
    static fun trunc(x: double): double { return trunc(x) }
    static fun fmod(x: double, y: double): double { return fmod(x, y) }
    static fun remainder(x: double, y: double): double { return remainder(x, y) }

    static fun abs(x: double): double { return abs(x) }
    static fun absInt(x: int): int { return abs(x) }

    static fun min(x: double, y: double): double { return min(x, y) }
    static fun max(x: double, y: double): double { return max(x, y) }
    static fun minInt(x: int, y: int): int { return min(x, y) }
    static fun maxInt(x: int, y: int): int { return max(x, y) }

    static fun signum(x: double): double { return signum(x) }
    static fun copysign(x: double, y: double): double { return copysign(x, y) }

    static fun toDegrees(rad: double): double { return degrees(rad) }
    static fun toRadians(deg: double): double { return radians(deg) }

    static fun clamp(x: double, min: double, max: double): double {
        if (x < min) return min
        if (x > max) return max
        return x
    }

    static fun lerp(a: double, b: double, t: double): double {
        return a + (b - a) * t
    }
}