import { sin, cos, tan, sqrt, pow, abs, floor, ceil, round, log, log10, exp, min, max, atan2, cbrt, hypot, asin, acos, atan, sinh, cosh, tanh, degrees, radians, log2, trunc, sign, fmod, erf } "native:Math"

/// Mathematical constants and functions (Python math-like module).
export val PI = 3.141592653589793
export val E = 2.718281828459045
export val TAU = 6.283185307179586
export val PHI = 1.618033988749895

export fun sin(x: double): double { return sin(x) }
export fun cos(x: double): double { return cos(x) }
export fun tan(x: double): double { return tan(x) }
export fun asin(x: double): double { return asin(x) }
export fun acos(x: double): double { return acos(x) }
export fun atan(x: double): double { return atan(x) }
export fun atan2(y: double, x: double): double { return atan2(y, x) }
export fun sinh(x: double): double { return sinh(x) }
export fun cosh(x: double): double { return cosh(x) }
export fun tanh(x: double): double { return tanh(x) }
export fun sqrt(x: double): double { return sqrt(x) }
export fun cbrt(x: double): double { return cbrt(x) }
export fun pow(base: double, exp: double): double { return pow(base, exp) }
export fun exp(x: double): double { return exp(x) }
export fun log(x: double): double { return log(x) }
export fun log2(x: double): double { return log2(x) }
export fun log10(x: double): double { return log10(x) }
export fun hypot(x: double, y: double): double { return hypot(x, y) }
export fun degrees(x: double): double { return degrees(x) }
export fun radians(x: double): double { return radians(x) }
export fun erf(x: double): double { return erf(x) }

/// Absolute value for any ordered type.
export fun abs(x: any): any {
    if (x < 0) { return -x }
    return x
}

export fun floor(x: double): double { return floor(x) }
export fun ceil(x: double): double { return ceil(x) }
export fun round(x: double): double { return round(x) }
export fun trunc(x: double): double { return trunc(x) }
export fun sign(x: double): double { return sign(x) }
export fun fmod(x: double, y: double): double { return fmod(x, y) }

/// Minimum of two comparable values.
export fun min(a: any, b: any): any {
    if (a < b) { return a }
    return b
}

/// Maximum of two comparable values.
export fun max(a: any, b: any): any {
    if (a > b) { return a }
    return b
}

/// Greatest common divisor (Euclidean algorithm).
export fun gcd(a: int, b: int): int {
    a = abs(a)
    b = abs(b)
    while (b != 0) {
        val t = b
        b = a % b
        a = t
    }
    return a
}

/// Least common multiple.
export fun lcm(a: int, b: int): int {
    if (a == 0 && b == 0) { return 0 }
    return abs(a) / gcd(a, b) * abs(b)
}

/// True if a and b are within tol of each other.
export fun is_close(a: double, b: double, tol: double): bool {
    return abs(a - b) <= tol
}

/// Restrict x to the closed interval [lo, hi].
export fun clamp(x: double, lo: double, hi: double): double {
    if (x < lo) { return lo }
    if (x > hi) { return hi }
    return x
}

/// Sum of elements of an array (numbers).
export fun sum(items: any[]): any {
    var total = 0
    for (var i = 0; i < len(items); i = i + 1) {
        total = total + items[i]
    }
    return total
}
