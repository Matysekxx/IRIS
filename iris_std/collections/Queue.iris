import "collections.LinkedList"

/// FIFO (First-In-First-Out) queue backed by a LinkedList.
export class Queue<T> {
    private val list: LinkedList<T>

    Queue() {
        this.list = new LinkedList<T>()
    }

    fun enqueue(item: T) { this.list.addLast(item) }
    fun dequeue(): T {
        if (this.isEmpty()) { throw "Queue is empty" }
        return this.list.removeFirst()
    }

    fun peek(): T {
        if (this.isEmpty()) { throw "Queue is empty" }
        return this.list.peekFirst()
    }

    fun isEmpty(): bool { return this.list.isEmpty() }
    fun size(): int { return this.list.size() }
    fun clear() { this.list.clear() }
}