import "core.Iterable"
import "collections.ArrayList"

/// Functional-style operations on Iterable collections
export class Iterables {
    static fun map<T, U>(iterable: Iterable<T>, fn: (T) -> U): ArrayList<U> {
        val result = new ArrayList<U>()
        val iter = iterable.iterator()
        while (iter.hasNext()) {
            result.push(fn(iter.next()))
        }
        return result
    }

    static fun filter<T>(iterable: Iterable<T>, predicate: (T) -> bool): ArrayList<T> {
        val result = new ArrayList<T>()
        val iter = iterable.iterator()
        while (iter.hasNext()) {
            val item = iter.next()
            if (predicate(item)) { result.push(item) }
        }
        return result
    }

    static fun reduce<T, U>(iterable: Iterable<T>, initial: U, fn: (U, T) -> U): U {
        var acc = initial
        val iter = iterable.iterator()
        while (iter.hasNext()) {
            acc = fn(acc, iter.next())
        }
        return acc
    }

    static fun forEach<T>(iterable: Iterable<T>, action: (T) -> void) {
        val iter = iterable.iterator()
        while (iter.hasNext()) {
            action(iter.next())
        }
    }

    static fun toArray<T>(iterable: Iterable<T>): ArrayList<T> {
        val result = new ArrayList<T>()
        val iter = iterable.iterator()
        while (iter.hasNext()) {
            result.push(iter.next())
        }
        return result
    }

    static fun anyMatch<T>(iterable: Iterable<T>, predicate: (T) -> bool): bool {
        val iter = iterable.iterator()
        while (iter.hasNext()) {
            if (predicate(iter.next())) { return true }
        }
        return false
    }

    static fun allMatch<T>(iterable: Iterable<T>, predicate: (T) -> bool): bool {
        val iter = iterable.iterator()
        while (iter.hasNext()) {
            if (!predicate(iter.next())) { return false }
        }
        return true
    }

    static fun count<T>(iterable: Iterable<T>): int {
        var count = 0
        val iter = iterable.iterator()
        while (iter.hasNext()) {
            iter.next()
            count = count + 1
        }
        return count
    }

    static fun first<T>(iterable: Iterable<T>): Optional<T> {
        val iter = iterable.iterator()
        if (iter.hasNext()) { return Optional.of(iter.next()) }
        return Optional.empty()
    }

    static fun last<T>(iterable: Iterable<T>): Optional<T> {
        val iter = iterable.iterator()
        if (!iter.hasNext()) { return Optional.empty() }
        var last = iter.next()
        while (iter.hasNext()) { last = iter.next() }
        return Optional.of(last)
    }

    static fun toMap<K, V>(iterable: Iterable<Pair<K, V>>): HashMap<K, V> {
        val result = new HashMap<K, V>()
        val iter = iterable.iterator()
        while (iter.hasNext()) {
            val pair = iter.next()
            result.put(pair.first, pair.second)
        }
        return result
    }

    static fun groupBy<T, K>(iterable: Iterable<T>, keyFn: (T) -> K): HashMap<K, ArrayList<T>> {
        val result = new HashMap<K, ArrayList<T>>()
        val iter = iterable.iterator()
        while (iter.hasNext()) {
            val item = iter.next()
            val key = keyFn(item)
            var list = result.get(key)
            if (list == null) {
                list = new ArrayList<T>()
                result.put(key, list)
            }
            list.push(item)
        }
        return result
    }
}