import "collections.ArrayList"
import "core.Iterable"

/// Double-ended queue backed by a circular array.
/// O(1) amortized insert/remove at both ends.
export class ArrayDeque<T> : Deque<T> {
    private var data: T[]
    private var head: int
    private var tail: int
    private var _size: int

    ArrayDeque() {
        this.data = T[8]
        this.head = 0
        this.tail = 0
        this._size = 0
    }

    override fun size(): int { return this._size }
    override fun isEmpty(): bool { return this._size == 0 }

    override fun addFirst(item: T) {
        if (this._size == len(this.data)) { this.grow() }
        this.head = (this.head - 1 + len(this.data)) % len(this.data)
        this.data[this.head] = item
        this._size = this._size + 1
    }

    override fun addLast(item: T) {
        if (this._size == len(this.data)) { this.grow() }
        this.data[this.tail] = item
        this.tail = (this.tail + 1) % len(this.data)
        this._size = this._size + 1
    }

    override fun removeFirst(): T {
        if (this.isEmpty()) { throw "Deque is empty" }
        val item = this.data[this.head]
        this.data[this.head] = null
        this.head = (this.head + 1) % len(this.data)
        this._size = this._size - 1
        return item
    }

    override fun removeLast(): T {
        if (this.isEmpty()) { throw "Deque is empty" }
        this.tail = (this.tail - 1 + len(this.data)) % len(this.data)
        val item = this.data[this.tail]
        this.data[this.tail] = null
        this._size = this._size - 1
        return item
    }

    override fun peekFirst(): T {
        if (this.isEmpty()) { return null }
        return this.data[this.head]
    }

    override fun peekLast(): T {
        if (this.isEmpty()) { return null }
        return this.data[(this.tail - 1 + len(this.data)) % len(this.data)]
    }

    override fun clear() {
        this.data = T[8]
        this.head = 0
        this.tail = 0
        this._size = 0
    }

    override fun iterator(): Iterator<T> {
        return new ArrayDequeIterator<T>(this)
    }

    private fun grow() {
        val newLen = len(this.data) * 2
        val newData = T[newLen]
        for (var i = 0; i < this._size; i = i + 1) {
            newData[i] = this.data[(this.head + i) % len(this.data)]
        }
        this.data = newData
        this.head = 0
        this.tail = this._size
    }
}

class ArrayDequeIterator<T> : Iterator<T> {
    private val deque: ArrayDeque<T>
    private var pos: int
    private var remaining: int

    ArrayDequeIterator(deque: ArrayDeque<T>) {
        this.deque = deque
        this.pos = 0
        this.remaining = deque.size()
    }

    override fun hasNext(): bool { return this.remaining > 0 }

    override fun next(): T {
        if (!this.hasNext()) { throw "NoSuchElementException" }
        val item = this.deque.peekFirst()
        this.deque.removeFirst()
        this.remaining = this.remaining - 1
        return item
    }
}