import "core.Iterable"

/// Node in a doubly-linked list
class LinkedListNode<T> {
    var item: T
    var next: LinkedListNode<T>
    var prev: LinkedListNode<T>

    LinkedListNode(item: T) {
        this.item = item
        this.next = null
        this.prev = null
    }
}

/// Iterator for LinkedList
class LinkedListIterator<T> : Iterator<T> {
    private var current: LinkedListNode<T>

    LinkedListIterator(head: LinkedListNode<T>) {
        this.current = head
    }

    override fun hasNext(): bool {
        return this.current != null
    }

    override fun next(): T {
        if (this.current == null) { throw "NoSuchElementException" }
        val item = this.current.item
        this.current = this.current.next
        return item
    }
}

/// Doubly-linked list implementing List<T>.
/// O(1) insert/remove at both ends, O(n) indexed access.
export class LinkedList<T> : List<T> {
    private var head: LinkedListNode<T>
    private var tail: LinkedListNode<T>
    private var _size: int

    LinkedList() {
        this.head = null
        this.tail = null
        this._size = 0
    }

    override fun size(): int { return this._size }
    override fun isEmpty(): bool { return this._size == 0 }

    override fun get(index: int): T {
        this.rangeCheck(index)
        var current = this.head
        for (var i = 0; i < index; i = i + 1) {
            current = current.next
        }
        return current.item
    }

    override fun set(index: int, item: T) {
        this.rangeCheck(index)
        var current = this.head
        for (var i = 0; i < index; i = i + 1) {
            current = current.next
        }
        current.item = item
    }

    override fun add(item: T) {
        this.addLast(item)
    }

    fun addFirst(item: T) {
        val newNode = new LinkedListNode<T>(item)
        val h = this.head
        if (h == null) {
            this.head = newNode
            this.tail = newNode
        } else {
            newNode.next = h
            h.prev = newNode
            this.head = newNode
        }
        this._size = this._size + 1
    }

    fun addLast(item: T) {
        val newNode = new LinkedListNode<T>(item)
        val t = this.tail
        if (t == null) {
            this.head = newNode
            this.tail = newNode
        } else {
            t.next = newNode
            newNode.prev = t
            this.tail = newNode
        }
        this._size = this._size + 1
    }

    override fun removeAt(index: int): T {
        this.rangeCheck(index)
        var current = this.head
        for (var i = 0; i < index; i = i + 1) {
            current = current.next
        }
        val p = current.prev
        val n = current.next
        if (p != null) { p.next = n } else { this.head = n }
        if (n != null) { n.prev = p } else { this.tail = p }
        this._size = this._size - 1
        return current.item
    }

    fun removeFirst(): T {
        if (this.head == null) { return null }
        return this.removeAt(0)
    }

    fun removeLast(): T {
        if (this.tail == null) { return null }
        return this.removeAt(this._size - 1)
    }

    fun peekFirst(): T {
        if (this.head == null) { return null }
        return this.head.item
    }

    fun peekLast(): T {
        if (this.tail == null) { return null }
        return this.tail.item
    }

    override fun clear() {
        this.head = null
        this.tail = null
        this._size = 0
    }

    override fun iterator(): Iterator<T> {
        return new LinkedListIterator<T>(this.head)
    }

    private fun rangeCheck(index: int) {
        if (index < 0 || index >= this._size) {
            throw "IndexOutOfBounds: " + index
        }
    }
}