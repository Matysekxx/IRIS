import "collections.ArrayList"

/// LIFO (Last-In-First-Out) stack backed by an ArrayList.
export class Stack<T> {
    private val list: ArrayList<T>

    Stack() {
        this.list = new ArrayList<T>()
    }

    fun push(item: T) {
        this.list.add(item)
    }

    fun pop(): T {
        if (this.isEmpty()) { throw "Stack is empty" }
        return this.list.removeAt(this.list.size() - 1)
    }

    fun peek(): T {
        if (this.isEmpty()) { throw "Stack is empty" }
        return this.list.get(this.list.size() - 1)
    }

    fun isEmpty(): bool { return this.list.isEmpty() }
    fun size(): int { return this.list.size() }

    fun clear() { this.list.clear() }

    fun toArray(): Array<T> {
        val result = new Array<T>(this.size())
        for (var i = 0; i < this.size(); i = i + 1) {
            result.push(this.list.get(i))
        }
        return result
    }
}