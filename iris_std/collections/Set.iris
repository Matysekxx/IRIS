import "collections.HashMap"
import "core.Iterable"

/// Hash set backed by a HashMap. O(1) average-time add/contains/remove.
export class HashSet<T> : Set<T> {
    private val map: HashMap<T, bool>

    HashSet() {
        this.map = new HashMap<T, bool>()
    }

    override fun size(): int { return this.map.size() }
    override fun isEmpty(): bool { return this.map.isEmpty() }

    override fun add(item: T): bool {
        if (this.contains(item)) { return false }
        this.map.put(item, true)
        return true
    }

    override fun contains(item: T): bool {
        return this.map.containsKey(item)
    }

    override fun remove(item: T): bool {
        if (!this.contains(item)) { return false }
        this.map.remove(item)
        return true
    }

    override fun clear() { this.map.clear() }

    override fun iterator(): Iterator<T> {
        return new HashSetIterator<T>(this.map.keys())
    }

    fun toArray(): Array<T> { return this.map.keys() }

    fun union(other: Set<T>): HashSet<T> {
        val result = new HashSet<T>()
        val iter = this.iterator()
        while (iter.hasNext()) { result.add(iter.next()) }
        val otherIter = other.iterator()
        while (otherIter.hasNext()) { result.add(otherIter.next()) }
        return result
    }

    fun intersection(other: Set<T>): HashSet<T> {
        val result = new HashSet<T>()
        val iter = this.iterator()
        while (iter.hasNext()) {
            val item = iter.next()
            if (other.contains(item)) { result.add(item) }
        }
        return result
    }

    fun difference(other: Set<T>): HashSet<T> {
        val result = new HashSet<T>()
        val iter = this.iterator()
        while (iter.hasNext()) {
            val item = iter.next()
            if (!other.contains(item)) { result.add(item) }
        }
        return result
    }
}

/// Iterator for HashSet
class HashSetIterator<T> : Iterator<T> {
    private val arr: Array<T>
    private var index: int

    HashSetIterator(arr: Array<T>) {
        this.arr = arr
        this.index = 0
    }

    override fun hasNext(): bool { return this.index < this.arr.size() }

    override fun next(): T {
        val item = this.arr.get(this.index)
        this.index = this.index + 1
        return item
    }
}