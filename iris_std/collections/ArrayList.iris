import "core.Iterable"

/// Iterator for ArrayList
class ArrayListIterator<T> : Iterator<T> {
    private val list: ArrayList<T>
    private var index: int

    ArrayListIterator(list: ArrayList<T>) {
        this.list = list
        this.index = 0
    }

    override fun hasNext(): bool {
        return this.index < this.list.size()
    }

    override fun next(): T {
        val item = this.list.get(this.index)
        this.index = this.index + 1
        return item
    }
}

/// Dynamic array (growable) implementing List<T>.
/// O(1) indexed access, amortized O(1) append, O(n) insert/remove.
export class ArrayList<T> : List<T> {
    private var data: T[]
    private var _size: int

    ArrayList() {
        this._size = 0
        this.data = T[8]
    }

    ArrayList(initialCapacity: int) {
        if (initialCapacity < 8) { initialCapacity = 8 }
        this._size = 0
        this.data = T[initialCapacity]
    }

    override fun size(): int { return this._size }
    override fun isEmpty(): bool { return this._size == 0 }

    override fun get(index: int): T {
        this.rangeCheck(index)
        return this.data[index]
    }

    override fun set(index: int, item: T) {
        this.rangeCheck(index)
        this.data[index] = item
    }

    override fun add(item: T) { this.push(item) }

    fun push(item: T) {
        if (this._size == len(this.data)) {
            this.grow(len(this.data) * 2)
        }
        this.data[this._size] = item
        this._size = this._size + 1
    }

    fun pop(): T {
        if (this._size == 0) { return null }
        this._size = this._size - 1
        val item = this.data[this._size]
        this.data[this._size] = null
        return item
    }

    override fun removeAt(index: int): T {
        this.rangeCheck(index)
        val item = this.data[index]
        for (var i = index; i < this._size - 1; i = i + 1) {
            this.data[i] = this.data[i + 1]
        }
        this._size = this._size - 1
        this.data[this._size] = null
        return item
    }

    override fun clear() {
        this.data = T[8]
        this._size = 0
    }

    override fun iterator(): Iterator<T> {
        return new ArrayListIterator<T>(this)
    }

    fun contains(item: T): bool {
        for (var i = 0; i < this._size; i = i + 1) {
            if (this.data[i] == item) { return true }
        }
        return false
    }

    fun indexOf(item: T): int {
        for (var i = 0; i < this._size; i = i + 1) {
            if (this.data[i] == item) { return i }
        }
        return -1
    }

    fun lastIndexOf(item: T): int {
        for (var i = this._size - 1; i >= 0; i = i - 1) {
            if (this.data[i] == item) { return i }
        }
        return -1
    }

    fun toArray(): T[] {
        val result = T[this._size]
        for (var i = 0; i < this._size; i = i + 1) {
            result[i] = this.data[i]
        }
        return result
    }

    protected fun grow(newCapacity: int) {
        val newData = T[newCapacity]
        for (var i = 0; i < this._size; i = i + 1) {
            newData[i] = this.data[i]
        }
        this.data = newData
    }

    protected fun rangeCheck(index: int) {
        if (index < 0 || index >= this._size) {
            throw "IndexOutOfBounds: " + index
        }
    }
}