/// Result type for error handling without exceptions
export class Result<T, E> {
    private val value: T
    private val error: E
    private val isOk: bool

    private Result(value: T, error: E, isOk: bool) {
        this.value = value
        this.error = error
        this.isOk = isOk
    }

    static fun ok(value: T): Result<T, any> {
        return new Result<T, any>(value, null, true)
    }

    static fun err(error: E): Result<any, E> {
        return new Result<any, E>(null, error, false)
    }

    fun isOk(): bool { return this.isOk }
    fun isErr(): bool { return !this.isOk }

    fun unwrap(): T {
        if (!this.isOk) { throw "unwrap on Err: " + this.error }
        return this.value
    }

    fun unwrapOr(default: T): T {
        if (this.isOk) { return this.value }
        return default
    }

    fun unwrapOrElse(fn: (E) -> T): T {
        if (this.isOk) { return this.value }
        return fn(this.error)
    }

    fun unwrapErr(): E {
        if (this.isOk) { throw "unwrapErr on Ok" }
        return this.error
    }

    fun expect(msg: string): T {
        if (!this.isOk) { throw msg + ": " + this.error }
        return this.value
    }

    fun map<U>(fn: (T) -> U): Result<U, E> {
        if (this.isOk) { return Result.ok(fn(this.value)) }
        return Result.err(this.error)
    }

    fun mapErr<F>(fn: (E) -> F): Result<T, F> {
        if (!this.isOk) { return Result.err(fn(this.error)) }
        return Result.ok(this.value)
    }

    fun flatMap<U>(fn: (T) -> Result<U, E>): Result<U, E> {
        if (this.isOk) { return fn(this.value) }
        return Result.err(this.error)
    }

    fun andThen<U>(fn: (T) -> Result<U, E>): Result<U, E> {
        return this.flatMap(fn)
    }

    fun orElse(fn: (E) -> Result<T, E>): Result<T, E> {
        if (!this.isOk) { return fn(this.error) }
        return this
    }

    fun ok(): Optional<T> {
        if (this.isOk) { return Optional.ofNullable(this.value) }
        return Optional.empty()
    }

    fun err(): Optional<E> {
        if (!this.isOk) { return Optional.ofNullable(this.error) }
        return Optional.empty()
    }

    fun toOptional(): Optional<T> {
        return this.ok()
    }
}