/// Types that can be compared for ordering
export interface Comparable<T> {
    fun compareTo(other: T): int
}

/// Base trait for hashable objects
export interface Hashable {
    fun hashCode(): int
}

/// Helper for reversed comparison (descending order)
export class Comparators {
    static fun reversed<T>(cmp: (T, T) -> int): (T, T) -> int {
        return fun(a: T, b: T): int { return -cmp(a, b) }
    }

    static fun naturalOrder<T: Comparable<T>>(): (T, T) -> int {
        return fun(a: T, b: T): int { return a.compareTo(b) }
    }

    static fun nullsFirst<T>(cmp: (T, T) -> int): (T?, T?) -> int {
        return fun(a: T?, b: T?): int {
            if (a == null && b == null) return 0
            if (a == null) return -1
            if (b == null) return 1
            return cmp(a, b)
        }
    }

    static fun nullsLast<T>(cmp: (T, T) -> int): (T?, T?) -> int {
        return fun(a: T?, b: T?): int {
            if (a == null && b == null) return 0
            if (a == null) return 1
            if (b == null) return -1
            return cmp(a, b)
        }
    }
}