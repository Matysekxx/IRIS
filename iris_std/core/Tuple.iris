/// A pair of two values (generic tuple)
export class Pair<A, B> {
    val first: A
    val second: B

    Pair(first: A, second: B) {
        this.first = first
        this.second = second
    }

    fun mapFirst<C>(fn: (A) -> C): Pair<C, B> {
        return new Pair<C, B>(fn(this.first), this.second)
    }

    fun mapSecond<C>(fn: (B) -> C): Pair<A, C> {
        return new Pair<A, C>(this.first, fn(this.second))
    }

    fun swap(): Pair<B, A> {
        return new Pair<B, A>(this.second, this.first)
    }

    fun toArray(): any[] {
        return [this.first, this.second]
    }

    fun toString(): string {
        return "(" + this.first + ", " + this.second + ")"
    }

    fun equals(other: any): bool {
        if (other !is Pair) { return false }
        return this.first == other.first && this.second == other.second
    }
}

/// A triple of three values
export class Triple<A, B, C> {
    val first: A
    val second: B
    val third: C

    Triple(first: A, second: B, third: C) {
        this.first = first
        this.second = second
        this.third = third
    }

    fun toArray(): any[] {
        return [this.first, this.second, this.third]
    }

    fun toString(): string {
        return "(" + this.first + ", " + this.second + ", " + this.third + ")"
    }
}