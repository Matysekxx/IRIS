import { time } "native:System"
import { exit as nativeExit } "native:System"
import { getenv } "native:System"
import { setenv } "native:System"
import { processExec } "native:System"

/// Process execution and environment access. Execute shell commands, manage environment variables, and control the current process.
export class Process {
    private val exitCode: int
    private val output: string

    Process(exitCode: int, output: string) {
        this.exitCode = exitCode
        this.output = output
    }

    fun getExitCode(): int {
        return this.exitCode
    }

    fun getOutput(): string {
        return this.output
    }

    static fun exit(code: int) {
        nativeExit(code)
    }

    static fun uptime(): double {
        return time()
    }

    static fun exec(command: string): Process {
        val res = processExec(command)
        if (res == null) { return new Process(-1, "Execution failed") }
        return new Process(res[0], res[1])
    }

    static fun getenv(name: string): string {
        return getenv(name)
    }

    static fun setenv(name: string, value: string): bool {
        return setenv(name, value)
    }
}
