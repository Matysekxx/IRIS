import { hash } "native:System"

/// Root of the IRIS object model. Every class implicitly derives from Object.
/// Provides the three fundamental operations used throughout the std: textual
/// representation, hashing and equality.
export class Object {
    /// Human-readable representation. Override in subclasses.
    fun toString(): string {
        return "Object"
    }

    /// Stable hash code for use in hash-based collections.
    fun hashCode(): int {
        return hash(this)
    }

    /// Structural equality. The default is reference identity.
    fun equals(other: any): bool {
        return this == other
    }
}
