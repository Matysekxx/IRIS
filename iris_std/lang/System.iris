from System import native time
from System import native hash
from System import native assert
from System import native exit as nativeExit
from System import native charToString
from System import native getType
from System import native getClassName

/// System-level utilities: time, hashing, assertions, type introspection, and process control.
class System {
    static fun currentTimeMillis(): double {
        return time()
    }

    static fun hash(obj: any): int {
        return hash(obj)
    }

    static fun assert(cond: bool, msg: string) {
        assert(cond, msg)
    }

    static fun exit(code: int) {
        nativeExit(code)
    }

    static fun charToString(c: int): string {
        return charToString(c)
    }

    static fun getType(obj: any): string {
        return getType(obj)
    }

    static fun getClassName(obj: any): string {
        return getClassName(obj)
    }
}
