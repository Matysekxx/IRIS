/// Efficient string builder that accumulates parts without repeated concatenation.
import * std/lang/String

export class StringBuilder {
    private var buffer: string[]
    private var _size: int

    /// Create an empty StringBuilder.
    StringBuilder() {
        this.buffer = new string[8]
        this._size = 0
    }

    fun append(s: any): StringBuilder {
        val strVal = String.valueOf(s)
        if (this._size == len(this.buffer)) {
            this.grow()
        }
        this.buffer[this._size] = strVal
        this._size = this._size + 1
        return this
    }

    fun toString(): string {
        var result = ""
        for (var i = 0; i < this._size; i = i + 1) {
            result = result + this.buffer[i]
        }
        return result
    }

    fun clear() {
        this.buffer = new string[8]
        this._size = 0
    }

    private fun grow() {
        val newBuffer = new string[len(this.buffer) * 2]
        for (var i = 0; i < this._size; i = i + 1) {
            newBuffer[i] = this.buffer[i]
        }
        this.buffer = newBuffer
    }
}
