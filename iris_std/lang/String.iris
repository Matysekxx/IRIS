from System import native stringSubstring
from System import native stringIndexOf
from System import native stringSplit
from System import native stringTrim
from System import native stringToLower
from System import native stringToUpper
from System import native stringReplace
from System import native stringStartsWith
from System import native stringEndsWith
from System import native stringContains
from System import native stringReverse
from System import native stringRepeat
from System import native stringPadLeft
from System import native stringPadRight
from System import native stringParseInt
from System import native stringParseDouble

class String {
    static fun substring(s: string, start: int, end: int): string {
        return stringSubstring(s, start, end)
    }

    static fun indexOf(s: string, sub: string): int {
        return stringIndexOf(s, sub)
    }

    static fun split(s: string, delim: string): string[] {
        return stringSplit(s, delim)
    }

    static fun trim(s: string): string {
        return stringTrim(s)
    }

    static fun toLower(s: string): string {
        return stringToLower(s)
    }

    static fun toUpper(s: string): string {
        return stringToUpper(s)
    }

    static fun replace(s: string, search: string, replacement: string): string {
        return stringReplace(s, search, replacement)
    }

    static fun startsWith(s: string, prefix: string): bool {
        return stringStartsWith(s, prefix)
    }

    static fun endsWith(s: string, suffix: string): bool {
        return stringEndsWith(s, suffix)
    }

    static fun contains(s: string, sub: string): bool {
        return stringContains(s, sub)
    }

    static fun reverse(s: string): string {
        return stringReverse(s)
    }

    static fun repeat(s: string, count: int): string {
        return stringRepeat(s, count)
    }

    static fun padLeft(s: string, totalWidth: int, padChar: string): string {
        return stringPadLeft(s, totalWidth, padChar)
    }

    static fun padRight(s: string, totalWidth: int, padChar: string): string {
        return stringPadRight(s, totalWidth, padChar)
    }

    static fun parseInt(s: string): int {
        return stringParseInt(s)
    }

    static fun parseDouble(s: string): double {
        return stringParseDouble(s)
    }

    static fun length(s: string): int {
        return len(s)
    }

    static fun valueOf(obj: any): string {
        return "" + obj
    }
}
