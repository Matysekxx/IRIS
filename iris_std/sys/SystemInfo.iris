import { getenv } "native:System"
import { setenv } "native:System"

/// Environment variable access (get and set).
export class Env {
    static fun get(name: string): string {
        return getenv(name)
    }

    static fun set(name: string, value: string): bool {
        return setenv(name, value)
    }
}

/// Command-line argument access (currently returns an empty array).
export class Args {
    static fun getArgs(): string[] {
        val a = new string[0]
        return a
    }
}

/// Terminal control: clear screen and set/reset ANSI colors.
export class Terminal {
    static fun clear() {
        print("\u001b[2J\u001b[H")
    }

    static fun setColor(colorCode: int) {
        print("\u001b[" + colorCode + "m")
    }

    static fun reset() {
        print("\u001b[0m")
    }
}
