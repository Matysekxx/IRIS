// IRIS Standard Library - iris.util.Lists
import "Collections"

class ArrayListIterator<T> : Iterator<T> {
    private val list: ArrayList<T>
    private var index: int

    ArrayListIterator(list: ArrayList<T>) {
        this.list = list
        this.index = 0
    }

    override fun hasNext(): bool {
        val l = this.list
        return this.index < l.size()
    }

    override fun next(): T {
        val l = this.list
        val item = l.get(this.index)
        this.index = this.index + 1
        return item
    }
}

class ArrayList<T> : List<T> {
    private var data: T[]
    private var _size: int

    ArrayList() {
        this._size = 0
        this.data = new T[8]
    }

    override fun size(): int { return this._size }
    override fun isEmpty(): bool { return this._size == 0 }

    override fun get(index: int): T {
        this.rangeCheck(index)
        return this.data[index]
    }

    override fun set(index: int, item: T) {
        this.rangeCheck(index)
        this.data[index] = item
    }

    override fun add(item: T) {
        this.push(item)
    }

    fun push(item: T) {
        if (this._size == len(this.data)) {
            this.grow(len(this.data) * 2)
        }
        this.data[this._size] = item
        this._size = this._size + 1
    }

    fun pop(): T {
        if (this._size == 0) { return null }
        this._size = this._size - 1
        val item = this.data[this._size]
        this.data[this._size] = null
        return item
    }

    override fun removeAt(index: int): T {
        this.rangeCheck(index)
        val item = this.data[index]
        for (var i = index; i < this._size - 1; i = i + 1) {
            this.data[i] = this.data[i + 1]
        }
        this._size = this._size - 1
        this.data[this._size] = null
        return item
    }

    override fun clear() {
        this.data = new T[8]
        this._size = 0
    }

    fun sort() {
        // Simple insertion sort
        for (var i = 1; i < this._size; i = i + 1) {
            val key = this.data[i]
            var j = i - 1
            while (j >= 0 && this.data[j] > key) {
                this.data[j + 1] = this.data[j]
                j = j - 1
            }
            this.data[j + 1] = key
        }
    }

    fun sortWith(comparator: (T, T) -> int) {
        for (var i = 1; i < this._size; i = i + 1) {
            val key = this.data[i]
            var j = i - 1
            while (j >= 0 && comparator(this.data[j], key) > 0) {
                this.data[j + 1] = this.data[j]
                j = j - 1
            }
            this.data[j + 1] = key
        }
    }

    override fun iterator(): Iterator<T> {
        return new ArrayListIterator<T>(this)
    }

    private fun grow(newCapacity: int) {
        val newData = new T[newCapacity]
        for (var i = 0; i < this._size; i = i + 1) {
            newData[i] = this.data[i]
        }
        this.data = newData
    }

    private fun rangeCheck(index: int) {
        if (index < 0 || index >= this._size) {
            throw "IndexOutOfBounds"
        }
    }
}

class LinkedListNode<T> {
    var item: T
    var next: LinkedListNode<T>
    var prev: LinkedListNode<T>

    LinkedListNode(item: T) {
        this.item = item
        this.next = null
        this.prev = null
    }
}

class LinkedListIterator<T> : Iterator<T> {
    private var current: LinkedListNode<T>

    LinkedListIterator(head: LinkedListNode<T>) {
        this.current = head
    }

    override fun hasNext(): bool {
        return this.current != null
    }

    override fun next(): T {
        if (this.current == null) { throw "NoSuchElementException" }
        val item = this.current.item
        this.current = this.current.next
        return item
    }
}

class LinkedList<T> : List<T> {
    private var head: LinkedListNode<T>
    private var tail: LinkedListNode<T>
    private var _size: int

    LinkedList() {
        this.head = null
        this.tail = null
        this._size = 0
    }

    override fun size(): int { return this._size }
    override fun isEmpty(): bool { return this._size == 0 }

    override fun get(index: int): T {
        this.rangeCheck(index)
        var current = this.head
        for (var i = 0; i < index; i = i + 1) {
            current = current.next
        }
        return current.item
    }

    override fun set(index: int, item: T) {
        this.rangeCheck(index)
        var current = this.head
        for (var i = 0; i < index; i = i + 1) {
            current = current.next
        }
        current.item = item
    }

    override fun add(item: T) {
        val newNode = new LinkedListNode<T>(item)
        val h = this.head
        if (h == null) {
            this.head = newNode
            this.tail = newNode
        } else {
            val t = this.tail
            t.next = newNode
            newNode.prev = t
            this.tail = newNode
        }
        this._size = this._size + 1
    }

    fun addFirst(item: T) {
        val newNode = new LinkedListNode<T>(item)
        val h = this.head
        if (h == null) {
            this.head = newNode
            this.tail = newNode
        } else {
            newNode.next = h
            h.prev = newNode
            this.head = newNode
        }
        this._size = this._size + 1
    }

    fun removeFirst(): T {
        val h = this.head
        if (h == null) { return null }
        val item = h.item
        val nextNode = h.next
        this.head = nextNode
        if (nextNode != null) {
            nextNode.prev = null
        } else {
            this.tail = null
        }
        this._size = this._size - 1
        return item
    }

    fun removeLast(): T {
        val t = this.tail
        if (t == null) { return null }
        val item = t.item
        val prevNode = t.prev
        this.tail = prevNode
        if (prevNode != null) {
            prevNode.next = null
        } else {
            this.head = null
        }
        this._size = this._size - 1
        return item
    }

    override fun removeAt(index: int): T {
        this.rangeCheck(index)
        var current = this.head
        for (var i = 0; i < index; i = i + 1) {
            current = current.next
        }
        val p = current.prev
        val n = current.next
        if (p != null) {
            p.next = n
        } else {
            this.head = n
        }
        if (n != null) {
            n.prev = p
        } else {
            this.tail = p
        }
        this._size = this._size - 1
        return current.item
    }

    override fun clear() {
        this.head = null
        this.tail = null
        this._size = 0
    }

    override fun iterator(): Iterator<T> {
        return new LinkedListIterator<T>(this.head)
    }

    private fun rangeCheck(index: int) {
        if (index < 0 || index >= this._size) {
            throw "IndexOutOfBounds"
        }
    }
}

class Stack<T> {
    private val list: ArrayList<T>

    Stack() {
        this.list = new ArrayList<T>()
    }

    fun push(item: T) {
        val l = this.list
        l.add(item)
    }

    fun pop(): T {
        if (this.isEmpty()) { throw "Stack is empty" }
        val l = this.list
        return l.removeAt(l.size() - 1)
    }

    fun peek(): T {
        if (this.isEmpty()) { throw "Stack is empty" }
        val l = this.list
        return l.get(l.size() - 1)
    }

    fun isEmpty(): bool {
        val l = this.list
        return l.isEmpty()
    }

    fun size(): int {
        val l = this.list
        return l.size()
    }
}

class Queue<T> {
    private val list: LinkedList<T>

    Queue() {
        this.list = new LinkedList<T>()
    }

    fun enqueue(item: T) {
        val l = this.list
        l.add(item)
    }

    fun dequeue(): T {
        if (this.isEmpty()) { throw "Queue is empty" }
        val l = this.list
        return l.removeFirst()
    }

    fun peek(): T {
        if (this.isEmpty()) { throw "Queue is empty" }
        val l = this.list
        return l.get(0)
    }

    fun isEmpty(): bool {
        val l = this.list
        return l.isEmpty()
    }

    fun size(): int {
        val l = this.list
        return l.size()
    }
}
