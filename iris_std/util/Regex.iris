import "String"

from Regex import native match as nativeMatch
from Regex import native find as nativeFind
from Regex import native replace as nativeReplace
from Regex import native split as nativeSplit

/// A compiled regular expression pattern. Supports match, find, replace, and split operations.
class Pattern {
    private val pattern: string

    Pattern(pattern: string) {
        this.pattern = pattern
    }

    static fun compile(pattern: string): Pattern {
        return new Pattern(pattern)
    }

    fun match(input: string): bool {
        return nativeMatch(this.pattern, input)
    }

    fun find(input: string): int {
        return nativeFind(this.pattern, input)
    }

    fun replace(input: string, replacement: string): string {
        return nativeReplace(this.pattern, input, replacement)
    }

    fun split(input: string): string[] {
        return nativeSplit(this.pattern, input)
    }

    fun test(input: string): bool {
        return this.match(input)
    }

    fun toString(): string {
        return "/" + this.pattern + "/"
    }
}

/// Static regular expression utilities (match, find, replace, split, escape).
class Regex {
    static fun match(pattern: string, input: string): bool {
        return nativeMatch(pattern, input)
    }

    static fun find(pattern: string, input: string): int {
        return nativeFind(pattern, input)
    }

    static fun replace(pattern: string, input: string, replacement: string): string {
        return nativeReplace(pattern, input, replacement)
    }

    static fun split(pattern: string, input: string): string[] {
        return nativeSplit(pattern, input)
    }

    static fun isMatch(pattern: string, input: string): bool {
        return nativeMatch(pattern, input)
    }

    static fun escape(input: string): string {
        var result = ""
        for (var i = 0; i < String.length(input); i = i + 1) {
            val c = String.substring(input, i, i + 1)
            if (c == "\\" || c == "." || c == "^" || c == "$" || c == "*" ||
                c == "+" || c == "?" || c == "(" || c == ")" || c == "[" ||
                c == "]" || c == "{" || c == "}" || c == "|" || c == "/") {
                result = result + "\\"
            }
            result = result + c
        }
        return result
    }
}
