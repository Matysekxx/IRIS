// HashSet<T> ensures a collection of unique elements.
import "HashMap"
import "Set"

class HashSet<T> : Set<T> {
    private val map: HashMap<T, bool>

    HashSet() {
        this.map = new HashMap<T, bool>()
    }

    override fun add(item: T) {
        this.map.put(item, true)
    }

    override fun contains(item: T): bool {
        return this.map.containsKey(item)
    }

    override fun remove(item: T) {
        this.map.remove(item)
    }

    override fun size(): int {
        return this.map.size()
    }
}