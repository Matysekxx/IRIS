/// Map and Set implementations: HashMap (hash table), HashSet (hash set).
import { hash } "native:System"
import * as _ std/util/Collections

/// A key-value entry in a HashMap bucket chain.
class HashMapEntry<K, V> {
    val key: K
    var value: V
    var next: HashMapEntry<K, V>

    HashMapEntry(key: K, value: V) {
        this.key = key
        this.value = value
        this.next = null
    }
}

/// Hash table-based map with separate chaining and automatic resizing. Implements Map.
class HashMap<K, V> : Map<K, V> {
    private var buckets: HashMapEntry<K, V>[]
    private var _size: int
    private var loadFactor: double

    HashMap() {
        this._size = 0
        this.loadFactor = 0.75
        this.buckets = new HashMapEntry<K, V>[16]
    }

    override fun size(): int { return this._size }
    override fun isEmpty(): bool { return this._size == 0 }

    override fun put(key: K, value: V) {
        val limit = len(this.buckets) * this.loadFactor
        val cond = this._size > limit
        if (cond) {
            this.resize()
        }

        val h = hash(key)
        var idx = h % len(this.buckets)
        if (idx < 0) { idx = -idx }

        var current = this.buckets[idx]
        while (current != null) {
            if (current.key == key) {
                current.value = value
                return
            }
            current = current.next
        }

        val entry = new HashMapEntry<K, V>(key, value)
        entry.next = this.buckets[idx]
        this.buckets[idx] = entry
        this._size = this._size + 1
    }

    override fun get(key: K): V {
        val h = hash(key)
        var idx = h % len(this.buckets)
        if (idx < 0) { idx = -idx }

        var current = this.buckets[idx]
        while (current != null) {
            if (current.key == key) {
                return current.value
            }
            current = current.next
        }
        return null
    }

    override fun containsKey(key: K): bool {
        return this.get(key) != null
    }

    override fun remove(key: K): V {
        val h = hash(key)
        var idx = h % len(this.buckets)
        if (idx < 0) { idx = -idx }

        var current = this.buckets[idx]
        var prev: HashMapEntry<K, V> = null
        while (current != null) {
            if (current.key == key) {
                if (prev == null) {
                    this.buckets[idx] = current.next
                } else {
                    prev.next = current.next
                }
                this._size = this._size - 1
                return current.value
            }
            prev = current
            current = current.next
        }
        return null
    }

    fun keys(): K[] {
        val keysArr = new K[this._size]
        var count = 0
        for (var i = 0; i < len(this.buckets); i = i + 1) {
            var current = this.buckets[i]
            while (current != null) {
                keysArr[count] = current.key
                count = count + 1
                current = current.next
            }
        }
        return keysArr
    }

    private fun resize() {
        val oldBuckets = this.buckets
        val newLen = len(oldBuckets) * 2
        this.buckets = new HashMapEntry<K, V>[newLen]
        this._size = 0

        for (var i = 0; i < len(oldBuckets); i = i + 1) {
            var current = oldBuckets[i]
            while (current != null) {
                this.put(current.key, current.value)
                current = current.next
            }
        }
    }

    override fun clear() {
        this.buckets = new HashMapEntry<K, V>[16]
        this._size = 0
    }
}

/// Iterator for HashSet.
class HashSetIterator<T> : Iterator<T> {
    private val arr: T[]
    private var index: int

    HashSetIterator(arr: T[]) {
        this.arr = arr
        this.index = 0
    }

    override fun hasNext(): bool {
        return this.index < len(this.arr)
    }

    override fun next(): T {
        val item = this.arr[this.index]
        this.index = this.index + 1
        return item
    }
}

/// Hash set backed by a HashMap. Implements Set with O(1) average-time add/contains/remove.
class HashSet<T> : Set<T> {
    private val map: HashMap<T, bool>

    HashSet() {
        this.map = new HashMap<T, bool>()
    }

    override fun size(): int {
        val m = this.map
        return m.size()
    }

    override fun isEmpty(): bool {
        val m = this.map
        return m.isEmpty()
    }

    override fun add(item: T): bool {
        if (this.contains(item)) { return false }
        val m = this.map
        m.put(item, true)
        return true
    }

    override fun contains(item: T): bool {
        val m = this.map
        return m.containsKey(item)
    }

    override fun remove(item: T): bool {
        if (!this.contains(item)) { return false }
        val m = this.map
        m.remove(item)
        return true
    }

    override fun clear() {
        val m = this.map
        m.clear()
    }

    override fun iterator(): Iterator<T> {
        val m = this.map
        return new HashSetIterator<T>(m.keys())
    }
}
