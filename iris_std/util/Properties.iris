import "String"
import "Maps"

class Properties {
    private val props: HashMap<string, string>

    Properties() {
        this.props = new HashMap<string, string>()
    }

    static fun load(text: string): Properties {
        val p = new Properties()
        val lines = String.split(text, "\n")
        for (var i = 0; i < len(lines); i = i + 1) {
            val line = String.trim(lines[i])
            if (String.length(line) == 0) { continue }
            if (String.startsWith(line, "#") || String.startsWith(line, "!")) { continue }

            val eqPos = String.indexOf(line, "=")
            if (eqPos == -1) { continue }

            val key = String.trim(String.substring(line, 0, eqPos))
            var value = String.trim(String.substring(line, eqPos + 1, String.length(line)))

            // Unescape
            value = String.replace(value, "\\n", "\n")
            value = String.replace(value, "\\t", "\t")
            value = String.replace(value, "\\r", "\r")
            value = String.replace(value, "\\:", ":")
            value = String.replace(value, "\\=", "=")

            p.props.put(key, value)
        }
        return p
    }

    static fun loadFile(path: string): Properties {
        from System import native fsReadText
        val content = fsReadText(path)
        return Properties.load(content)
    }

    fun get(key: string): string {
        return this.props.get(key)
    }

    fun getOrDefault(key: string, defaultVal: string): string {
        val v = this.props.get(key)
        if (v == null) { return defaultVal }
        return v
    }

    fun set(key: string, value: string) {
        this.props.put(key, value)
    }

    fun contains(key: string): bool {
        return this.props.containsKey(key)
    }

    fun remove(key: string) {
        this.props.remove(key)
    }

    fun size(): int {
        return this.props.size()
    }

    fun keys(): string[] {
        return this.props.keys()
    }

    fun toFileFormat(): string {
        val keysArr = this.props.keys()
        var result = ""
        for (var i = 0; i < len(keysArr); i = i + 1) {
            result = result + keysArr[i] + "=" + this.props.get(keysArr[i]) + "\n"
        }
        return result
    }

    fun save(path: string) {
        from System import native fsWriteText
        fsWriteText(path, this.toFileFormat())
    }
}
