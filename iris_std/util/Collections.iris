// IRIS Standard Library - iris.util.Collections

interface Iterable<T> {
    fun iterator(): Iterator<T>
}

interface Iterator<T> {
    fun hasNext(): bool
    fun next(): T
}

interface List<T> : Iterable<T> {
    fun size(): int
    fun isEmpty(): bool
    fun get(index: int): T
    fun set(index: int, item: T)
    fun add(item: T)
    fun removeAt(index: int): T
    fun clear()
}

interface Set<T> : Iterable<T> {
    fun size(): int
    fun isEmpty(): bool
    fun add(item: T): bool
    fun contains(item: T): bool
    fun remove(item: T): bool
    fun clear()
}

interface Map<K, V> {
    fun size(): int
    fun isEmpty(): bool
    fun put(key: K, value: V)
    fun get(key: K): V
    fun containsKey(key: K): bool
    fun remove(key: K): V
    fun clear()
}

class Optional<T> {
    private val value: T
    private val present: bool

    Optional(value: T, present: bool) {
        this.value = value
        this.present = present
    }

    static fun of(value: any): Optional<any> {
        if (value == null) { throw "Optional.of cannot take null" }
        return new Optional<any>(value, true)
    }

    static fun ofNullable(value: any): Optional<any> {
        if (value == null) { return new Optional<any>(null, false) }
        return new Optional<any>(value, true)
    }

    static fun empty(): Optional<any> {
        return new Optional<any>(null, false)
    }

    fun isPresent(): bool { return this.present }
    
    fun get(): T {
        if (!this.present) { throw "NoSuchElementException" }
        return this.value
    }
    
    fun orElse(other: T): T {
        if (this.present) { return this.value }
        return other
    }
}

class Collections {
    static fun reverse(list: List<any>) {
        val size = list.size()
        for (var i = 0; i < size / 2; i = i + 1) {
            val temp = list.get(i)
            list.set(i, list.get(size - 1 - i))
            list.set(size - 1 - i, temp)
        }
    }

    static fun fill(list: List<any>, obj: any) {
        val size = list.size()
        for (var i = 0; i < size; i = i + 1) {
            list.set(i, obj)
        }
    }

    static fun copy(dest: List<any>, src: List<any>) {
        if (dest.size() < src.size()) { throw "Source does not fit in dest" }
        for (var i = 0; i < src.size(); i = i + 1) {
            dest.set(i, src.get(i))
        }
    }
}
