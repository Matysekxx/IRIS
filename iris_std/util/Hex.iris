from Hex import native encode
from Hex import native decode

/// Hexadecimal encoding and decoding.
class Hex {
    static fun encode(input: string): string {
        return encode(input)
    }

    static fun decode(input: string): string {
        return decode(input)
    }

    static fun encodeBytes(bytes: any[]): string {
        var result = ""
        for (var i = 0; i < len(bytes); i = i + 1) {
            val b = bytes[i]
            // Convert each byte to hex manually since we can't bitwise AND in IRIS
        }
        return result
    }
}
