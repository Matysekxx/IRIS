import * std/lang/String
import * std/util/Stopwatch

/// Multi-level logger with global and per-instance severity thresholds.
export class Logger {
    private val name: string
    private var level: int
    private static var globalLevel: int = 0

    /// Finest-grained diagnostic messages
    static val TRACE = 0
    /// Detailed information for debugging
    static val DEBUG = 1
    /// General informational messages
    static val INFO  = 2
    /// Potentially harmful situations
    static val WARN  = 3
    /// Errors that might still allow the application to continue
    static val ERROR = 4

    /// Create a new logger with the given name and default level INFO.
    Logger(name: string) {
        this.name = name
        this.level = Logger.INFO
    }

    /// Obtain or create a logger by name.
    static fun getLogger(name: string): Logger {
        return new Logger(name)
    }

    /// Set the global severity threshold (messages below this level are suppressed).
    static fun setGlobalLevel(level: int) {
        Logger.globalLevel = level
    }

    /// Set this instance's severity threshold.
    fun setLevel(level: int) {
        this.level = level
    }

    private fun log(level: int, levelName: string, msg: string) {
        if (level < Logger.globalLevel || level < this.level) { return }
        print("[" + levelName + "] " + this.name + ": " + msg)
    }

    /// Log a TRACE message.
    fun trace(msg: string) {
        this.log(Logger.TRACE, "TRACE", msg)
    }

    /// Log a DEBUG message.
    fun debug(msg: string) {
        this.log(Logger.DEBUG, "DEBUG", msg)
    }

    /// Log an INFO message.
    fun info(msg: string) {
        this.log(Logger.INFO, "INFO", msg)
    }

    /// Log a WARN message.
    fun warn(msg: string) {
        this.log(Logger.WARN, "WARN", msg)
    }

    /// Log an ERROR message.
    fun error(msg: string) {
        this.log(Logger.ERROR, "ERROR", msg)
    }

    /// Returns true if TRACE messages are enabled at the current level.
    fun isTraceEnabled(): bool { return Logger.TRACE >= Logger.globalLevel && Logger.TRACE >= this.level }
    /// Returns true if DEBUG messages are enabled at the current level.
    fun isDebugEnabled(): bool { return Logger.DEBUG >= Logger.globalLevel && Logger.DEBUG >= this.level }
    /// Returns true if INFO messages are enabled at the current level.
    fun isInfoEnabled(): bool  { return Logger.INFO >= Logger.globalLevel && Logger.INFO >= this.level }
}
