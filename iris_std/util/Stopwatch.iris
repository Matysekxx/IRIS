from System import native time

/// High-resolution stopwatch for measuring elapsed time with millisecond precision.
class Stopwatch {
    private var startTime: double
    private var running: bool

    Stopwatch() {
        this.startTime = 0.0
        this.running = false
    }

    static fun startNew(): Stopwatch {
        val sw = new Stopwatch()
        sw.start()
        return sw
    }

    fun start() {
        this.startTime = time()
        this.running = true
    }

    fun stop(): double {
        if (!this.running) { return 0.0 }
        this.running = false
        return time() - this.startTime
    }

    fun reset() {
        this.startTime = 0.0
        this.running = false
    }

    fun restart() {
        this.start()
    }

    fun elapsedMillis(): double {
        if (this.running) {
            return time() - this.startTime
        }
        return 0.0
    }

    fun elapsedSeconds(): double {
        return this.elapsedMillis() / 1000.0
    }

    fun isRunning(): bool {
        return this.running
    }

    fun toString(): string {
        return this.elapsedMillis() + "ms"
    }
}
