class Pair<K, V> {
    val first: K
    val second: V

    Pair(first: K, second: V) {
        this.first = first
        this.second = second
    }

    fun getFirst(): K { return this.first }
    fun getSecond(): V { return this.second }

    fun toString(): string {
        return "(" + this.first + ", " + this.second + ")"
    }

    fun equals(other: any): bool {
        if (other == null) { return false }
        val o = other as Pair<any, any>
        if (o == null) { return false }
        return this.first == o.first && this.second == o.second
    }
}
