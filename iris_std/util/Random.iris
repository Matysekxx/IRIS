import { random } "native:System"
import { randomInt } "native:System"

/// Random number generator. Uses native OS randomness by default, or a seedable LCG for deterministic sequences.
export class Random {
    private var seed: int
    private var useNative: bool

    Random() {
        this.seed = 123456789
        this.useNative = true
    }

    Random(seed: int) {
        this.seed = seed
        this.useNative = false
    }

    fun nextInt(max: int): int {
        if (max <= 0) { return 0 }
        if (this.useNative) {
            return randomInt(0, max - 1)
        }
        this.seed = (1103515245 * this.seed + 12345) % 2147483648
        if (this.seed < 0) { this.seed = -this.seed }
        return this.seed % max
    }

    fun nextDouble(): double {
        if (this.useNative) {
            return random()
        }
        this.seed = (1103515245 * this.seed + 12345) % 2147483648
        if (this.seed < 0) { this.seed = -this.seed }
        return (1.0 * this.seed) / 2147483648.0
    }
}
