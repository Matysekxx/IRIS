import "collections.ArrayList"

/// Efficient mutable string builder. Pre-allocates a buffer to minimize allocations.
export class StringBuilder {
    private var chunks: ArrayList<string>

    StringBuilder() {
        this.chunks = new ArrayList<string>()
    }

    StringBuilder(initial: string) {
        this.chunks = new ArrayList<string>()
        this.chunks.push(initial)
    }

    fun append(s: string): StringBuilder {
        this.chunks.push(s)
        return this
    }

    fun appendChar(c: byte): StringBuilder {
        this.chunks.push(string(c))
        return this
    }

    fun appendInt(n: int): StringBuilder {
        this.chunks.push(n.toString())
        return this
    }

    fun appendFloat(f: double): StringBuilder {
        this.chunks.push(f.toString())
        return this
    }

    fun appendBool(b: bool): StringBuilder {
        this.chunks.push(b.toString())
        return this
    }

    fun appendLine(s: string): StringBuilder {
        this.chunks.push(s)
        this.chunks.push("\n")
        return this
    }

    fun insert(index: int, s: string): StringBuilder {
        // Simple approach: rebuild with string at position
        val str = this.toString()
        this.clear()
        this.chunks.push(str.substring(0, index))
        this.chunks.push(s)
        this.chunks.push(str.substring(index))
        return this
    }

    fun clear() {
        this.chunks.clear()
    }

    fun length(): int {
        var len = 0
        for (var i = 0; i < this.chunks.size(); i = i + 1) {
            len = len + len(this.chunks.get(i))
        }
        return len
    }

    override fun toString(): string {
        if (this.chunks.isEmpty()) { return "" }
        var result = ""
        for (var i = 0; i < this.chunks.size(); i = i + 1) {
            result = result + this.chunks.get(i)
        }
        return result
    }
}