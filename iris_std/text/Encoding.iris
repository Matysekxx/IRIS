/// Character encoding and string conversion utilities.
export class Encoding {
    /// Encode a string to UTF-8 byte array
    static fun toUTF8(s: string): byte[] {
        val result = new byte[len(s) * 4]
        var pos = 0
        for (var i = 0; i < len(s); i = i + 1) {
            val cp = s.codePointAt(i)
            if (cp < 0x80) {
                result[pos] = byte(cp)
                pos = pos + 1
            } elsif (cp < 0x800) {
                result[pos] = byte(0xC0 | (cp >> 6))
                pos = pos + 1
                result[pos] = byte(0x80 | (cp & 0x3F))
                pos = pos + 1
            } elsif (cp < 0x10000) {
                result[pos] = byte(0xE0 | (cp >> 12))
                pos = pos + 1
                result[pos] = byte(0x80 | ((cp >> 6) & 0x3F))
                pos = pos + 1
                result[pos] = byte(0x80 | (cp & 0x3F))
                pos = pos + 1
            } else {
                result[pos] = byte(0xF0 | (cp >> 18))
                pos = pos + 1
                result[pos] = byte(0x80 | ((cp >> 12) & 0x3F))
                pos = pos + 1
                result[pos] = byte(0x80 | ((cp >> 6) & 0x3F))
                pos = pos + 1
                result[pos] = byte(0x80 | (cp & 0x3F))
                pos = pos + 1
            }
        }
        return result.slice(0, pos)
    }

    /// Decode a UTF-8 byte array to string
    static fun fromUTF8(bytes: byte[]): string {
        var result = ""
        var i = 0
        while (i < len(bytes)) {
            val b = bytes[i] & 0xFF
            var cp: int
            if (b < 0x80) {
                cp = b
                i = i + 1
            } elsif (b < 0xE0) {
                cp = (b & 0x1F) << 6 | (bytes[i+1] & 0x3F)
                i = i + 2
            } elsif (b < 0xF0) {
                cp = (b & 0x0F) << 12 | (bytes[i+1] & 0x3F) << 6 | (bytes[i+2] & 0x3F)
                i = i + 3
            } else {
                cp = (b & 0x07) << 18 | (bytes[i+1] & 0x3F) << 12 | (bytes[i+2] & 0x3F) << 6 | (bytes[i+3] & 0x3F)
                i = i + 4
            }
            result = result + string(cp)
        }
        return result
    }

    /// Encode string to Base64
    static fun toBase64(s: string): string {
        return Base64.encode(s)
    }

    /// Decode from Base64
    static fun fromBase64(s: string): string {
        return Base64.decode(s)
    }

    /// URL-encode a string (percent-encoding)
    static fun urlEncode(s: string): string {
        val hex = "0123456789ABCDEF"
        var result = ""
        for (var i = 0; i < len(s); i = i + 1) {
            val c = s.charAt(i)
            if ((c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z') || (c >= '0' && c <= '9') || c == '-' || c == '_' || c == '.' || c == '~') {
                result = result + c
            } elsif (c == ' ') {
                result = result + "+"
            } else {
                result = result + "%" + hex.charAt(c >> 4) + hex.charAt(c & 0xF)
            }
        }
        return result
    }

    /// URL-decode a string
    static fun urlDecode(s: string): string {
        var result = ""
        var i = 0
        while (i < len(s)) {
            if (s.charAt(i) == '%') {
                val hi = parseInt(s.substring(i+1, i+2), 16)
                val lo = parseInt(s.substring(i+2, i+3), 16)
                result = result + string(hi * 16 + lo)
                i = i + 3
            } elsif (s.charAt(i) == '+') {
                result = result + " "
                i = i + 1
            } else {
                result = result + s.charAt(i)
                i = i + 1
            }
        }
        return result
    }
}