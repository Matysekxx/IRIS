import "collections.ArrayList"
import "text.StringBuilder"

/// Simple XML builder and parser
export class XML {
    static fun escape(text: string): string {
        val sb = new StringBuilder()
        for (var i = 0; i < len(text); i = i + 1) {
            val c = text.charAt(i)
            if (c == '&') { sb.append("&amp;") }
            elsif (c == '<') { sb.append("&lt;") }
            elsif (c == '>') { sb.append("&gt;") }
            elsif (c == '"') { sb.append("&quot;") }
            elsif (c == '\'') { sb.append("&apos;") }
            else { sb.appendChar(c) }
        }
        return sb.toString()
    }

    static fun unescape(text: string): string {
        val sb = new StringBuilder()
        var i = 0
        while (i < len(text)) {
            if (text.charAt(i) == '&') {
                var end = i + 1
                while (end < len(text) && text.charAt(end) != ';') { end = end + 1 }
                val entity = text.substring(i + 1, end)
                if (entity == "amp") { sb.appendChar('&') }
                elsif (entity == "lt") { sb.appendChar('<') }
                elsif (entity == "gt") { sb.appendChar('>') }
                elsif (entity == "quot") { sb.appendChar('"') }
                elsif (entity == "apos") { sb.appendChar('\'') }
                else { sb.append("&" + entity + ";") }
                i = end + 1
            } else {
                sb.appendChar(text.charAt(i))
                i = i + 1
            }
        }
        return sb.toString()
    }

    static fun buildTag(name: string, attrs: HashMap<string, string>, content: string): string {
        val sb = new StringBuilder()
        sb.append("<")
        sb.append(name)
        if (attrs != null) {
            val iter = attrs.iterator()
            while (iter.hasNext()) {
                val entry = iter.next()
                sb.append(" ")
                sb.append(entry.key)
                sb.append("=\"")
                sb.append(XML.escape(entry.value))
                sb.append("\"")
            }
        }
        if (content == null || len(content) == 0) {
            sb.append(" />")
        } else {
            sb.append(">")
            sb.append(content)
            sb.append("</")
            sb.append(name)
            sb.append(">")
        }
        return sb.toString()
    }

    /// Simple tokenizer for XML parsing (non-validating)
    static fun parse(xml: string): XMLNode {
        return XMLParser(xml).parse()
    }
}

class XMLParser {
    private val input: string
    private var pos: int

    XMLParser(input: string) {
        this.input = input
        this.pos = 0
    }

    fun parse(): XMLNode {
        this.skipWhitespace()
        if (this.input.charAt(this.pos) != '<') { throw "Expected '<'" }
        this.pos = this.pos + 1
        val name = this.readName()
        val attrs = this.readAttributes()
        this.skipWhitespace()
        if (this.input.charAt(this.pos) == '/' && this.input.charAt(this.pos + 1) == '>') {
            this.pos = this.pos + 2
            return new XMLNode(name, attrs, null)
        }
        if (this.input.charAt(this.pos) != '>') { throw "Expected '>'" }
        this.pos = this.pos + 1
        val content = this.readContent(name)
        return new XMLNode(name, attrs, content)
    }

    private fun readName(): string {
        val start = this.pos
        while (this.pos < len(this.input) && this.input.charAt(this.pos) != ' ' && this.input.charAt(this.pos) != '>' && this.input.charAt(this.pos) != '/') {
            this.pos = this.pos + 1
        }
        return this.input.substring(start, this.pos)
    }

    private fun readAttributes(): HashMap<string, string> {
        val attrs = new HashMap<string, string>()
        this.skipWhitespace()
        while (this.pos < len(this.input) && this.input.charAt(this.pos) != '>' && this.input.charAt(this.pos) != '/') {
            val name = this.readName()
            this.skipWhitespace()
            if (this.input.charAt(this.pos) == '=') {
                this.pos = this.pos + 1
                this.skipWhitespace()
                val quote = this.input.charAt(this.pos)
                this.pos = this.pos + 1
                val start = this.pos
                while (this.pos < len(this.input) && this.input.charAt(this.pos) != quote) { this.pos = this.pos + 1 }
                val value = this.input.substring(start, this.pos)
                this.pos = this.pos + 1
                attrs.put(name, value)
            }
            this.skipWhitespace()
        }
        return attrs
    }

    private fun readContent(closingTag: string): string {
        val sb = new StringBuilder()
        while (this.pos < len(this.input)) {
            if (this.input.charAt(this.pos) == '<' && this.input.charAt(this.pos + 1) == '/') {
                // Closing tag
                this.pos = this.pos + 2
                val tagName = this.readName()
                this.skipWhitespace()
                if (this.input.charAt(this.pos) == '>') { this.pos = this.pos + 1 }
                if (tagName == closingTag) { break }
                sb.append("</")
                sb.append(tagName)
                sb.append(">")
            } elsif (this.input.charAt(this.pos) == '<') {
                // Nested element
                val child = this.parse()
                sb.append(child.toString())
            } else {
                sb.appendChar(this.input.charAt(this.pos))
                this.pos = this.pos + 1
            }
        }
        return sb.toString()
    }

    private fun skipWhitespace() {
        while (this.pos < len(this.input) && (this.input.charAt(this.pos) == ' ' || this.input.charAt(this.pos) == '\n' || this.input.charAt(this.pos) == '\t')) {
            this.pos = this.pos + 1
        }
    }
}

export class XMLNode {
    val name: string
    val attributes: HashMap<string, string>
    val content: string

    XMLNode(name: string, attributes: HashMap<string, string>, content: string) {
        this.name = name
        this.attributes = attributes
        this.content = content
    }

    fun toString(): string {
        val sb = new StringBuilder()
        sb.append("<")
        sb.append(this.name)
        if (this.attributes != null) {
            val iter = this.attributes.iterator()
            while (iter.hasNext()) {
                val entry = iter.next()
                sb.append(" ")
                sb.append(entry.key)
                sb.append("=\"")
                sb.append(XML.escape(entry.value))
                sb.append("\"")
            }
        }
        if (this.content == null || len(this.content) == 0) {
            sb.append(" />")
        } else {
            sb.append(">")
            sb.append(this.content)
            sb.append("</")
            sb.append(this.name)
            sb.append(">")
        }
        return sb.toString()
    }
}