import "text.StringBuilder"

/// String formatting utilities (printf-style)
export class Format {
    /// Format a string with positional arguments
    /// {{ and }} escape to literal braces
    static fun format(template: string, args: any[]): string {
        val sb = new StringBuilder()
        var i = 0
        var argIndex = 0
        while (i < len(template)) {
            if (template.charAt(i) == '{' && i + 1 < len(template) && template.charAt(i+1) == '{') {
                sb.appendChar('{')
                i = i + 2
            } elsif (template.charAt(i) == '}' && i + 1 < len(template) && template.charAt(i+1) == '}') {
                sb.appendChar('}')
                i = i + 2
            } elsif (template.charAt(i) == '{') {
                val end = template.indexOf('}', i + 1)
                val placeholder = template.substring(i + 1, end)
                var idx = argIndex
                var formatSpec = ""
                if (len(placeholder) > 0 && placeholder.charAt(0) >= '0' && placeholder.charAt(0) <= '9') {
                    val colon = placeholder.indexOf(':')
                    if (colon >= 0) {
                        idx = parseInt(placeholder.substring(0, colon))
                        formatSpec = placeholder.substring(colon + 1)
                    } else {
                        idx = parseInt(placeholder)
                    }
                } elsif (len(placeholder) > 0 && placeholder.charAt(0) == ':') {
                    formatSpec = placeholder.substring(1)
                }
                if (idx >= 0 && idx < len(args)) {
                    val value = args[idx]
                    if (len(formatSpec) > 0) {
                        sb.append(Format.formatValue(value, formatSpec))
                    } else {
                        if (value == null) { sb.append("null") }
                        else { sb.append(value.toString()) }
                    }
                } else {
                    sb.append("{")
                    sb.append(placeholder)
                    sb.append("}")
                }
                argIndex = argIndex + 1
                i = end + 1
            } else {
                sb.appendChar(template.charAt(i))
                i = i + 1
            }
        }
        return sb.toString()
    }

    private static fun formatValue(value: any, spec: string): string {
        if (spec == "d" || spec == "i") {
            // Integer
            if (value is int) { return (value as int).toString() }
            if (value is double) { return int(value as double).toString() }
            return value.toString()
        }
        if (spec == "f" || spec == "F") {
            if (value is double) { return (value as double).toString() }
            if (value is int) { return (value as int).toString() + ".0" }
            return value.toString()
        }
        if (spec == "s") { return value.toString() }
        if (spec == "x" || spec == "X") {
            val n = value as int
            val hex = "0123456789ABCDEF"
            var result = ""
            var v = n
            while (v > 0) {
                result = hex.charAt(v & 0xF) + result
                v = v >> 4
            }
            if (n == 0) { return "0" }
            return result
        }
        if (spec == "b") {
            val n = value as int
            var result = ""
            var v = n
            while (v > 0) {
                result = string((v & 1) + 48) + result
                v = v >> 1
            }
            if (n == 0) { return "0" }
            return result
        }
        return value.toString()
    }

    /// Pad string to the left (right-align)
    static fun padLeft(s: string, width: int, padChar: byte): string {
        if (len(s) >= width) { return s }
        var result = ""
        val padLen = width - len(s)
        for (var i = 0; i < padLen; i = i + 1) { result = result + padChar }
        return result + s
    }

    /// Pad string to the right (left-align)
    static fun padRight(s: string, width: int, padChar: byte): string {
        if (len(s) >= width) { return s }
        var result = s
        for (var i = len(s); i < width; i = i + 1) { result = result + padChar }
        return result
    }

    /// Center a string in a field
    static fun padCenter(s: string, width: int, padChar: byte): string {
        if (len(s) >= width) { return s }
        val totalPad = width - len(s)
        val leftPad = totalPad / 2
        val rightPad = totalPad - leftPad
        var result = ""
        for (var i = 0; i < leftPad; i = i + 1) { result = result + padChar }
        result = result + s
        for (var i = 0; i < rightPad; i = i + 1) { result = result + padChar }
        return result
    }
}