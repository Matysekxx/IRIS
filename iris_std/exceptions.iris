/// Base class for all errors raised with `throw`.
export class Exception {
    var message: string
    Exception(msg: string) {
        this.message = msg
    }
    fun toString(): string {
        return this.message
    }
}

export class ValueError : Exception {
    ValueError(m: string) { super.Exception(m) }
}

export class KeyError : Exception {
    KeyError(m: string) { super.Exception(m) }
}

export class IndexError : Exception {
    IndexError(m: string) { super.Exception(m) }
}

export class IOError : Exception {
    IOError(m: string) { super.Exception(m) }
}

export class TypeError : Exception {
    TypeError(m: string) { super.Exception(m) }
}

export class RuntimeError : Exception {
    RuntimeError(m: string) { super.Exception(m) }
}

export class ArgumentError : Exception {
    ArgumentError(m: string) { super.Exception(m) }
}

export class StateError : Exception {
    StateError(m: string) { super.Exception(m) }
}

export class NotImplementedError : Exception {
    NotImplementedError(m: string) { super.Exception(m) }
}
