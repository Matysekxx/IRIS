
fun main() {
    val size = 3
    val arr = new any[size][size][size]
    
    var count = 0
    for (var i = 0; i < size; i = i + 1) {
        for (var j = 0; j < size; j = j + 1) {
            for (var k = 0; k < size; k = k + 1) {
                arr[i][j][k] = count
                count = count + 1
            }
        }
    }

    var sum = 0
    for (var i = 0; i < size; i = i + 1) {
        for (var j = 0; j < size; j = j + 1) {
            for (var k = 0; k < size; k = k + 1) {
                sum = sum + arr[i][j][k]
            }
        }
    }
    
    print("Sum: " + sum)
    // 0+1+...+26 = (26*27)/2 = 13*27 = 351
    if (sum == 351) {
        print("Test PASSED")
    } else {
        print("Test FAILED: expected 351, got " + sum)
    }

    print("arr[1][1][1] = " + arr[1][1][1])
    // Index: 1*9 + 1*3 + 1 = 13
    if (arr[1][1][1] == 13) {
        print("Access PASSED")
    } else {
        print("Access FAILED: expected 13, got " + arr[1][1][1])
    }
}
main()
