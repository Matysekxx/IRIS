fun gt(a, b) { return a > b }

var a = 5
var b = 3.0
var r = gt(a, b)
print("5 > 3.0 = " + r + "\n")

var x = 3.0
var y = 5
var r2 = gt(x, y)
print("3.0 > 5 = " + r2 + "\n")

var c = 5.0
var d = 3.0
var r3 = gt(c, d)
print("5.0 > 3.0 = " + r3 + "\n")

var e = 5
var f = 3
var r4 = gt(e, f)
print("5 > 3 = " + r4 + "\n")

print("all done\n")
