import * "util.math"
import * "util.random"
import * "string"
import * "data.json"
import * "data.csv"
import * "util.regex"
import * "time.instant"

print("PI = " + PI)
print("sin(pi/2) = " + sin(PI / 2.0))
print("gcd(12, 8) = " + gcd(12, 8))
print("abs(-5) = " + abs(-5))
print("randint(1,6) = " + randint(1, 6))
print("lower('HELLO') = " + lower("HELLO"))
print("is_digit('123') = " + is_digit("123"))

val parsed = loads("{\"name\":\"iris\"}")
print("json loaded = " + (parsed != null))

val csv_data = "a,b,c\n1,2,3"
val rows = parse(csv_data)
print("csv rows = " + len(rows))

print("regex match = " + match("hello", "hello"))
print("regex find = " + find("world", "hello world"))

val dt = Instant.now()
print("dt year = " + dt.year())

