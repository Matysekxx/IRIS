// IRIS Standard Library - Math
// Performance-optimized math functions.

import native "Math" as nativeMath

class Math {
    /** @brief Returns the sine of a number. */
    static fun sin(v: double): double {
        return nativeMath.sin(v)
    }

    /** @brief Returns the cosine of a number. */
    static fun cos(v: double): double {
        return nativeMath.cos(v)
    }

    /** @brief Returns the square root of a number. */
    static fun sqrt(v: double): double {
        return nativeMath.sqrt(v)
    }

    /** @brief Returns the absolute value of a number. */
    static fun abs(v: double): double {
        return nativeMath.abs(v)
    }

    /** @brief Returns the value of a base raised to a power. */
    static fun pow(base: double, exp: double): double {
        return nativeMath.pow(base, exp)
    }
    
    /** @brief Returns the constant PI. */
    static val PI: double = 3.141592653589793
}
