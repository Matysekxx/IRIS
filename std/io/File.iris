// IRIS Standard Library - File IO
// Pure IRIS wrapper around native streams.

import native "Collections.NativeFileInputStream" as FileInputStream
import native "Collections.NativeFileOutputStream" as FileOutputStream

class File {
    /** @brief Reads the entire content of a file as a string. */
    static fun readAllText(path: string): string {
        val stream = new FileInputStream(path)
        if (!stream.isOpen()) {
            return ""
        }
        
        var result = ""
        var char = stream.read()
        while (char != -1) {
            result = result + char // This is slow but shows IRIS logic
            char = stream.read()
        }
        stream.close()
        return result
    }

    /** @brief Writes text to a file. */
    static fun writeAllText(path: string, text: string) {
        val stream = new FileOutputStream(path, false)
        for (var i = 0; i < len(text); i = i + 1) {
            stream.write(text[i])
        }
        stream.close()
    }
}
