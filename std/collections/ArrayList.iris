// IRIS Standard Library - ArrayList
// Strictly typed generic implementation.

import "List"
import "../lang/Iterator"

class ArrayListIterator<T> : Iterator<T> {
    private val list: ArrayList<T>
    private var cursor: int

    ArrayListIterator(list: ArrayList<T>) {
        this.list = list
        this.cursor = 0
    }

    override fun hasNext(): bool { 
        return this.cursor < this.list.size() 
    }

    override fun next(): T {
        val res = this.list.get(this.cursor)
        this.cursor = this.cursor + 1
        return res
    }
}

class ArrayList<T> : List<T> {
    private var data: T[]
    private var _size: int

    ArrayList() {
        this._size = 0
        this.data = new T[8]
    }

    ArrayList(initialCapacity: int) {
        this._size = 0
        this.data = new T[initialCapacity]
    }

    override fun size(): int { 
        return this._size 
    }

    override fun isEmpty(): bool { 
        return this._size == 0 
    }

    override fun contains(item: T): bool { 
        return this.indexOf(item) != -1 
    }

    override fun add(item: T): bool {
        if (this._size == len(this.data)) {
            this.ensureCapacity(len(this.data) * 2)
        }
        this.data[this._size] = item
        this._size = this._size + 1
        return true
    }

    override fun get(index: int): T {
        this.rangeCheck(index)
        return this.data[index]
    }

    override fun set(index: int, item: T): T {
        this.rangeCheck(index)
        val old = this.data[index]
        this.data[index] = item
        return old
    }

    override fun indexOf(item: T): int {
        for (var i = 0; i < this._size; i = i + 1) {
            if (this.data[i] == item) {
                return i
            }
        }
        return -1
    }

    override fun clear() {
        this.data = new T[8]
        this._size = 0
    }

    override fun remove(item: T): bool {
        val idx = this.indexOf(item)
        if (idx == -1) {
            return false
        }
        
        for (var i = idx; i < this._size - 1; i = i + 1) {
            this.data[i] = this.data[i + 1]
        }
        this._size = this._size - 1
        return true
    }

    private fun ensureCapacity(minCapacity: int) {
        val newData = new T[minCapacity]
        for (var i = 0; i < this._size; i = i + 1) {
            newData[i] = this.data[i]
        }
        this.data = newData
    }

    private fun rangeCheck(index: int) {
        if (index < 0 || index >= this._size) {
            throw "IndexOutOfBounds"
        }
    }

    override fun iterator(): Iterator<T> {
        return new ArrayListIterator<T>(this)
    }
}
