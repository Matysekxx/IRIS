// IRIS Standard Library - HashMap
// Strictly typed generic implementation.

import native "System"
import "Interfaces"

class HashMap<K, V> : Map<K, V> {
    private var buckets: Entry<K, V>[]
    private var _size: int = 0
    private val loadFactor: double = 0.75

    class Entry<K, V> : Map.Entry<K, V> {
        val key: K
        var value: V
        var next: Entry<K, V>

        Entry(key: K, value: V) {
            this.key = key
            this.value = value
            this.next = null
        }

        override fun getKey(): K = key
        override fun getValue(): V = value
    }

    HashMap() {
        this.buckets = new Entry<K, V>[16]
    }

    override fun size(): int = _size

    override fun isEmpty(): bool = _size == 0

    override fun put(key: K, value: V): V {
        val h = System.hash(key)
        var idx = h % len(buckets)
        if (idx < 0) idx = -idx

        var current = buckets[idx]
        while (current != null) {
            if (current.key == key) {
                val old = current.value
                current.value = value
                return old
            }
            current = current.next
        }

        val entry = new Entry<K, V>(key, value)
        entry.next = buckets[idx]
        buckets[idx] = entry
        _size++

        if (_size > len(buckets) * loadFactor) {
            this.resize()
        }
        return null
    }

    override fun get(key: K): V {
        val h = System.hash(key)
        var idx = h % len(buckets)
        if (idx < 0) idx = -idx

        var current = buckets[idx]
        while (current != null) {
            if (current.key == key) return current.value
            current = current.next
        }
        return null
    }

    override fun remove(key: K): V {
        val h = System.hash(key)
        var idx = h % len(buckets)
        if (idx < 0) idx = -idx

        var current = buckets[idx]
        var prev: Entry<K, V> = null

        while (current != null) {
            if (current.key == key) {
                if (prev == null) buckets[idx] = current.next
                else prev.next = current.next
                _size--
                return current.value
            }
            prev = current
            current = current.next
        }
        return null
    }

    override fun containsKey(key: K): bool {
        return this.get(key) != null
    }

    override fun clear() {
        this.buckets = new Entry<K, V>[16]
        _size = 0
    }

    private fun resize() {
        val oldBuckets = buckets
        buckets = new Entry<K, V>[len(oldBuckets) * 2]
        val oldSize = _size
        _size = 0 // Reset size as put will increment it

        for (var i = 0; i < len(oldBuckets); i++) {
            var current = oldBuckets[i]
            while (current != null) {
                this.put(current.key, current.value)
                current = current.next
            }
        }
        _size = oldSize // Restore actual size
    }
}
