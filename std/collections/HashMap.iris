// IRIS Standard Library - HashMap
// Strictly typed generic implementation.

import native "System"
import "Map"

class HashMapEntry<K, V> {
    val key: K
    var value: V
    var next: HashMapEntry<K, V>

    HashMapEntry(key: K, value: V) {
        this.key = key
        this.value = value
        this.next = null
    }

    fun getKey(): K { return this.key }
    fun getValue(): V { return this.value }
}

class HashMap<K, V> : Map<K, V> {
    private var buckets: HashMapEntry<K, V>[]
    private var _size: int
    private val loadFactor: double

    HashMap() {
        this._size = 0
        this.loadFactor = 0.75
        this.buckets = new HashMapEntry<K, V>[16]
    }

    override fun size(): int { return this._size }

    override fun isEmpty(): bool { return this._size == 0 }

    override fun put(key: K, value: V): V {
        val h = System.hash(key)
        var idx = h % len(this.buckets)
        if (idx < 0) { idx = -idx }

        var current = this.buckets[idx]
        while (current != null) {
            if (current.key == key) {
                val old = current.value
                current.value = value
                return old
            }
            current = current.next
        }

        val entry = new HashMapEntry<K, V>(key, value)
        entry.next = this.buckets[idx]
        this.buckets[idx] = entry
        this._size = this._size + 1

        if (this._size > len(this.buckets) * this.loadFactor) {
            this.resize()
        }
        return null
    }

    override fun get(key: K): V {
        val h = System.hash(key)
        var idx = h % len(this.buckets)
        if (idx < 0) { idx = -idx }

        var current = this.buckets[idx]
        while (current != null) {
            if (current.key == key) {
                return current.value
            }
            current = current.next
        }
        return null
    }

    override fun remove(key: K): V {
        val h = System.hash(key)
        var idx = h % len(this.buckets)
        if (idx < 0) { idx = -idx }

        var current = this.buckets[idx]
        var prev: HashMapEntry<K, V> = null

        while (current != null) {
            if (current.key == key) {
                if (prev == null) {
                    this.buckets[idx] = current.next
                } else {
                    prev.next = current.next
                }
                this._size = this._size - 1
                return current.value
            }
            prev = current
            current = current.next
        }
        return null
    }

    override fun containsKey(key: K): bool {
        return this.get(key) != null
    }

    override fun clear() {
        this.buckets = new HashMapEntry<K, V>[16]
        this._size = 0
    }

    private fun resize() {
        val oldBuckets = this.buckets
        this.buckets = new HashMapEntry<K, V>[len(oldBuckets) * 2]
        val oldSize = this._size
        this._size = 0

        for (var i = 0; i < len(oldBuckets); i = i + 1) {
            var current = oldBuckets[i]
            while (current != null) {
                this.put(current.key, current.value)
                current = current.next
            }
        }
        this._size = oldSize
    }
}
