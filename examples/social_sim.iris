// IRIS Social Network Simulator
// Demonstrates the power of the new modular Standard Library.
import "iris:builtins/Array"
import "iris:builtins/Map"
import "iris:builtins/Console"

class User {
    val name: string
    val friends: Array<string>
    
    User(name: string) {
        this.name = name
        this.friends = new Array<string>()
    }
    
    fun addFriend(friendName: string) {
        this.friends.push(friendName)
    }
}

fun main() {
    print("STARTING")
    Console.log("=== IRIS Social Network Simulator ===")
    
    // Map to store users by their name
    val users = new Map<string, User>()
    
    // Create some users
    val alice = new User("Alice")
    val bob = new User("Bob")
    val charlie = new User("Charlie")
    
    users.put("Alice", alice)
    users.put("Bob", bob)
    users.put("Charlie", charlie)
    
    // Establishing friendships
    Console.log("Connecting people...")
    alice.addFriend("Bob")
    alice.addFriend("Charlie")
    bob.addFriend("Alice")
    charlie.addFriend("Alice")
    
    // Array of names to iterate through
    val names = new Array<string>()
    names.push("Alice")
    names.push("Bob")
    names.push("Charlie")
    
    // Final report
    Console.log("--- Community Report ---")
    for (var i = 0; i < names.size(); i = i + 1) {
        val currentName = names.get(i)
        val user = users.get(currentName)
        
        Console.log("User: " + user.name + " (" + user.friends.size() + " friends)")
        
        for (var j = 0; j < user.friends.size(); j = j + 1) {
            Console.log("  -> Friend: " + user.friends.get(j))
        }
    }
    
    Console.log("=====================================")
    Console.log("Simulation complete.")
}

main()
